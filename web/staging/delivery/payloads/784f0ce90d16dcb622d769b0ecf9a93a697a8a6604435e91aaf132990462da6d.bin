<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1,maximum-scale=1"><title>Elimination Chamber Preview V4 — Transparent Logo Review</title><style>
*{box-sizing:border-box}html,body{margin:0;background:#030714;color:white;font-family:Arial,sans-serif;overflow-x:hidden}#viewport{position:relative;margin:auto;width:720px;height:1280px;transform-origin:top left}#board{width:720px;height:1280px;position:relative;overflow:hidden;background:#061029}.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,#02081738 0%,#07142b2a 20%,#020d23ed 36%,#030c20f5 100%)}.brand{position:absolute;top:24px;left:140px;width:440px;height:170px;object-fit:contain;filter:drop-shadow(0 3px 8px #000)}.event{position:absolute;top:194px;left:55px;width:610px;text-align:center;font:900 51px Impact,'Arial Narrow',sans-serif;letter-spacing:2px;text-shadow:0 2px 14px #000,0 0 14px #489aff}.event span{color:#91cbff}.bar{position:absolute;top:270px;left:65px;width:590px;height:45px;background:linear-gradient(90deg,#081b45,#2876ca,#081b45);border:1px solid #8ac7ff;text-align:center;font:900 27px/43px Impact,'Arial Narrow',sans-serif;letter-spacing:2px}.frame{position:absolute;top:330px;left:26px;width:668px;height:856px;padding:13px;border:3px solid #4a9ef5;border-radius:14px;background:linear-gradient(145deg,#0c2357ed,#030b1df2 70%);box-shadow:0 0 22px #2b7bd655}.strip{height:37px;background:#15509b;padding:9px 12px;display:flex;justify-content:space-between;font-size:15px;font-weight:900;letter-spacing:1px}.section{font:900 28px Impact,'Arial Narrow',sans-serif;letter-spacing:.5px;margin:10px 0 6px;display:flex;justify-content:space-between;align-items:end}.section small{font:700 11px Arial;color:#b6ddff}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.chamber{height:247px;border:2px solid #559cf1;background:radial-gradient(circle at 50% 50%,#194d91,#07162e 68%);position:relative;overflow:hidden}.chamber .label{text-align:center;font:900 20px Impact,sans-serif;margin-top:9px}.portraits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(2,1fr);gap:2px 5px;height:167px;padding:2px 9px;align-items:end}.portraits img{width:100%;height:79px;min-width:0;object-fit:contain;object-position:bottom;filter:drop-shadow(0 2px 5px #000)}.foot{text-align:center;font:800 12px Arial;border-top:1px solid #6caef6;padding-top:8px}.note{text-align:center;font-size:10px;color:#bddaff;margin-top:5px}.match{height:251px;border:2px solid #559cf1;background:radial-gradient(ellipse at 50% 70%,#204574,#071329 72%);position:relative;overflow:hidden}.match .matchtitle{font:900 22px Impact,sans-serif;text-align:center;margin:10px 0 0}.versus{display:flex;align-items:end;justify-content:space-between;height:176px;padding:0 12px}.versus .fighter{width:31%;height:171px;object-fit:contain;object-position:bottom;filter:drop-shadow(0 2px 8px #000)}.beltbox{width:35%;align-self:center;display:flex;flex-direction:column;align-items:center;gap:4px}.beltbox img{width:100%;height:106px;object-fit:contain;filter:brightness(1.75) contrast(1.18) saturate(1.2) drop-shadow(0 0 12px #e4b95d)}.beltbox strong{font:900 15px Impact;color:#ffe5a6}.match .foot{margin:0 10px}.story{height:103px;border:2px solid #559cf1;background:#0a1c3c;padding:13px;font:600 14px/1.4 Arial;color:#dcecff}.disclaimer{position:absolute;bottom:7px;left:0;width:100%;text-align:center;font:800 10px Arial;color:#c3ddff}.ticker{position:absolute;bottom:0;width:720px;height:76px;background:#04152f;border-top:3px solid #5ca9fa;display:flex;align-items:center;overflow:hidden}.ticklogo{width:152px;height:100%;display:flex;align-items:center;justify-content:center;background:#0b2b56;border-right:2px solid #6ab4ff;font:900 20px Impact;text-align:center}.ticktext{white-space:nowrap;font:900 17px Arial;padding-left:18px}.demo{color:#a7d8ff}
.event{top:183px;left:100px;width:520px;height:82px;display:flex;align-items:center;justify-content:center}.eventlogo{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 3px 5px #000) drop-shadow(0 0 8px #6bb5ff)}.ticklogo img{width:138px;height:65px;object-fit:contain;filter:drop-shadow(0 1px 4px #000)}
</style></head><body><div id="viewport"><main id="board"><img class="arena" src="__ISC_BASE__originals/shared/6a78bf5f1cf8117c4a9e541f4ce9cc8e5aae230f642e481b181afe0aa0169c7a.jpg"><div class="shade"></div><img class="brand" src="__ISC_BASE__originals/shared/6b8d91042edf7d48598c32f1b46d6451dfc9cc0c2d49eeb0e1a0be7b38d8fc13.png"><div class="event"><img class="eventlogo" alt="Elimination Chamber" src="__ISC_BASE__originals/shared/f728e3daf383868abeb0e83a02fb74b3069b0276eab82f0000a34c2ae1e273a5.png"></div><div class="bar">EVENT PREVIEW</div><div class="frame"><div class="strip"><span>ELIMINATION CHAMBER · PREVIEW</span><span>ROAD TO WRESTLEMANIA</span></div><div class="section">MEN'S & WOMEN'S CHAMBER <small>CONFIRMED ENTRANTS ONLY</small></div><div class="two"><div class="chamber"><div class="label">MEN'S CHAMBER · 6 ENTRANTS</div><div class="portraits"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"></div><div class="foot">ENTRANT HEADSHOT FORMAT</div><div class="note">Sample portraits · not announced entrants</div></div><div class="chamber"><div class="label">WOMEN'S CHAMBER · 6 ENTRANTS</div><div class="portraits"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><img src="__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><img src="__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><img src="__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png"></div><div class="foot">ENTRANT HEADSHOT FORMAT</div><div class="note">Sample portraits · not announced entrants</div></div></div><div class="section">CHAMPIONSHIP MATCHUPS <small>HEADSHOTS + VISIBLE TITLE BELT</small></div><div class="match"><div class="matchtitle">CHAMPIONSHIP MATCH · DESIGN DEMO</div><div class="versus"><img class="fighter" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><div class="beltbox"><img src="__ISC_BASE__originals/shared/5566b3d55992daebc107e6e685805692c622e3e163d7d1afe8889463da513389.png"><strong>CHAMPIONSHIP</strong></div><img class="fighter" src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"></div><div class="foot">CHALLENGER &nbsp; • &nbsp; TITLE &nbsp; • &nbsp; CHAMPION</div></div><div class="section">ROAD TO WRESTLEMANIA <small>STAKES & STORYLINES</small></div><div class="story">Confirmed Chamber participants, championship matches, and announced appearances will populate here as official information becomes available.</div><div class="disclaimer">DESIGN REVIEW ONLY · SAMPLE PORTRAITS ARE NOT CONFIRMED PARTICIPANTS</div></div><div class="ticker"><div class="ticklogo"><img alt="Elimination Chamber" src="__ISC_BASE__originals/shared/f728e3daf383868abeb0e83a02fb74b3069b0276eab82f0000a34c2ae1e273a5.png"></div><div class="ticktext">EVENT PREVIEW ◆ CHAMBER ENTRANTS ◆ CHAMPIONSHIP MATCHUPS ◆ ROAD TO WRESTLEMANIA</div></div></main></div><script>function fit(){const w=Math.min(innerWidth,720),s=w/720;const v=document.getElementById('viewport');v.style.transform='scale('+s+')';v.style.width='720px';v.style.marginLeft='0';document.body.style.height=(1280*s)+'px';}addEventListener('resize',fit);fit();</script></body></html>