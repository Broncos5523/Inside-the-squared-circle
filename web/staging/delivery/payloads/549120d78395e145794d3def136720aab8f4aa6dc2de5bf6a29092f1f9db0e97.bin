.banner{background:linear-gradient(90deg,#09172b,#194b78,#09172b);border-color:#d7b46d}.match{border-color:#b4c9e3!important;background:linear-gradient(110deg,#132e49ef,#060b16f5 55%,#132e49ef)!important}.heading{background:#17446b!important;border-color:#d7b46d!important;color:#fff}.footer{background:#0a213b!important;border-color:#d7b46d!important}.names strong{color:#f1cb7c}.event{filter:drop-shadow(0 0 12px #d7b46d)}
