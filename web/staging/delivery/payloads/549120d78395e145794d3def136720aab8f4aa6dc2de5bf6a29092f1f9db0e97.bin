<!DOCTYPE html>

<html><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>WrestleMania 43 Night Two Preview V1 — Review</title><style>
*{box-sizing:border-box}html,body{margin:0;background:#06070c;color:white;font-family:Arial,sans-serif;overflow-x:hidden}#holder{width:720px;height:1280px;position:relative;margin:0 auto}#board{width:720px;height:1280px;position:absolute;top:0;left:0;overflow:hidden;background:#05070b}.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(#02040bb8,#02050aeb 30%,#040609f8)}.brand{position:absolute;top:8px;left:125px;width:470px;height:103px;object-fit:contain}.event{position:absolute;top:112px;left:108px;width:504px;height:138px;object-fit:contain;filter:drop-shadow(0 0 12px #e8bc54)}.banner{position:absolute;top:255px;left:40px;width:640px;text-align:center;padding:13px;border-block:2px solid #c99b43;background:linear-gradient(90deg,#17223a,#4b3b26,#17223a);font:900 30px Impact,Arial Black,sans-serif;letter-spacing:3px}.matches{position:absolute;top:338px;left:25px;width:670px;display:grid;gap:13px}.match{height:244px;border:2px solid #d2a64d;border-radius:8px;background:linear-gradient(110deg,#18233bea,#070a11f5 55%,#18233bea);position:relative;overflow:hidden;box-shadow:0 0 13px #d2a64d44}.heading{height:42px;background: #614412;border-bottom:2px solid #e74b53;text-align:center;font:900 25px Impact,Arial Black,sans-serif;letter-spacing:1.5px;padding:7px}.versus{position:relative;height:160px}.fighter{position:absolute;bottom:0;width:218px;height:160px;object-fit:contain;object-position:bottom;filter:drop-shadow(0 0 7px #000)}.left{left:0}.right{right:0;transform:scaleX(-1)}.belt{position:absolute;left:237px;top:26px;width:192px;height:111px;object-fit:contain;filter:brightness(1.7) contrast(1.15) drop-shadow(0 0 10px #f9dca2)}.names{height:38px;text-align:center;font-weight:900;font-size:17px;padding:9px;background:#080d18}.names strong{color:#e2c27d;margin:0 16px}.footer{position:absolute;bottom:0;width:720px;height:68px;background:#210a10;border-top:3px solid #e13e4d;display:flex;align-items:center}.footer img{width:145px;height:55px;object-fit:contain;margin:0 12px}.footer span{font-size:15px;font-weight:900;letter-spacing:1px}.disclaimer{position:absolute;bottom:72px;width:100%;text-align:center;font-size:10px;color:#bfc9d9}

.event{filter:drop-shadow(0 0 12px #e9b75b)}.match{border-color:#b88a36!important}.banner{color:#f7d68a!important}
.footer img{width:158px;height:60px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(255,215,0,.35))}.footer span{font-size:14px}

