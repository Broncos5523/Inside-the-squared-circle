/* WrestleMania Night One spectacle: source artwork, logic and approved assets retained */
#board:before{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;background:repeating-linear-gradient(111deg,transparent 0 85px,#ffd97612 86px 88px,transparent 90px 190px);mix-blend-mode:screen}
