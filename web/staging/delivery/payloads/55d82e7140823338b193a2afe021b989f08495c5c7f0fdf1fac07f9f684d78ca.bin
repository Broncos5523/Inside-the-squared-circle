.venue{background:linear-gradient(90deg,rgba(25,76,48,.79),rgba(12,34,29,.73),rgba(86,68,26,.76))!important}
.ticker{background:linear-gradient(90deg,rgba(8,54,34,.95),rgba(55,43,16,.96),rgba(5,15,14,.96))!important}
</style><style id="v7-belt-visibility-only">
/* Brighten authentic belts without changing approved sizes, positions or tile layout. */
.mainResult.titleResult .mainBelt img{
 filter:brightness(2.05) contrast(1.16) saturate(1.38) drop-shadow(0 0 7px rgba(255,214,114,.80)) drop-shadow(0 4px 5px rgba(0,0,0,.90))!important;
}
.additional.titleResult .otherBelt img{
 filter:brightness(2.05) contrast(1.16) saturate(1.38) drop-shadow(0 0 5px rgba(255,214,114,.80)) drop-shadow(0 3px 4px rgba(0,0,0,.90))!important;
}
</style></head><body><main id="board">
<img class="arena" src="assets/user-riyadh-stadium-new.jpeg" alt="User-approved WrestleMania arena"><div class="tint"></div><div class="beam left"></div><div class="beam right"></div>
<img class="brand" src="assets/user-approved-mancave-logo.png" alt="Man Cave Sports Book Presents Inside the Squared Circle"><div class="brandkicker">WWE PREMIUM LIVE EVENT · RIYADH</div><div class="eventplate"><img src="assets/wrestlemania43-logo-transparent.png" alt="WrestleMania 43 Riyadh 2027 logo"></div><div class="barMask"></div>
<div class="resultsbar"><h1>RESULTS &amp; FALLOUT</h1><p id="dateBar">WRESTLEMANIA 43 · APRIL 2027</p></div><div class="sampleFlag">SAMPLE OUTCOMES · DESIGN DEMONSTRATION</div>
<section class="frame"><div class="inner"><div class="topstrip"><span>WRESTLEMANIA 43 · RIYADH</span><span class="nightlabel" id="nightTop">NIGHT ONE</span></div>
<div class="section"><h2 id="mainHeading">NIGHT ONE · MAIN EVENT RESULT</h2><small id="mainStatus">AWAITING VERIFIED RESULTS</small></div>
<div class="mainResult" id="mainResult"><div class="mainLabel" id="mainLabel">RESULT PENDING</div><div class="mainCopy"><div class="mainName" id="mainName">MAIN EVENT</div><div class="mainDetail" id="mainDetail">Official result pending</div><div class="mainDesc" id="mainDesc">Night One results will appear after official confirmation.</div></div><div class="mainPhoto" id="mainPhoto"></div><div class="mainBelt" id="mainBelt"></div></div>
<div class="resultsHeading"><h2>OTHER MATCH RESULTS</h2><small id="otherStatus">RESULTS AS CONFIRMED</small></div><div class="additional" id="additional"><div class="otherCopy"><div class="otherLabel" id="otherLabel">AWAITING OFFICIAL RESULTS</div><div class="otherName" id="otherName">MATCH RESULTS</div><div class="otherDetail" id="otherDetail">Verified outcomes only</div><div class="otherDesc" id="otherDesc">Matches rotate as results are confirmed.</div></div><div class="otherPhotos" id="otherPhotos"></div><div class="otherBelt" id="otherBelt"></div></div>
<div class="falloutHeading"><h2>FALLOUT &amp; STORYLINES</h2><small id="falloutStatus">AFTER THE EVENT</small></div><div class="fallout"><h3 id="falloutTitle">THE AFTERMATH</h3><p id="falloutBody">Confirmed championship changes, rivalries and key developments from each night will appear here.</p></div><div class="venue" id="venue">RIYADH, SAUDI ARABIA · VENUE TO BE ANNOUNCED</div></div></section>
<div class="reviewNotice" id="reviewNotice">VISUAL REVIEW ONLY · LIVE RESULTS NOT CONNECTED</div><footer class="ticker"><div class="tickerLogo"><img src="assets/wwe-show-mark-from-user-image.png" alt="WWE brand logo"></div><div class="tickerTrack"><span id="tickerText">WRESTLEMANIA 43 ◆ NIGHT ONE &amp; NIGHT TWO ◆ RESULTS &amp; FALLOUT ◆ VERIFIED WINNERS ◆ CHAMPIONSHIP DEVELOPMENTS ◆ WRESTLEMANIA 43 ◆ NIGHT ONE &amp; NIGHT TWO ◆ RESULTS &amp; FALLOUT ◆ VERIFIED WINNERS ◆ CHAMPIONSHIP DEVELOPMENTS ◆</span></div></footer>
</main>
<script>
(()=>{'use strict';
 const B=document.getElementById('board');function resize(){B.style.transform='scale('+Math.min(innerWidth/720,innerHeight/1280)+')'}addEventListener('resize',resize);resize();
 const E=id=>document.getElementById(id);const p=new URLSearchParams(location.search);const demo=true;const nightParam=p.get('night');let active=nightParam==='2'?1:0,otherIndex=0,falloutIndex=0;
 const demos=[
 {number:1,main_event:{outcome:'decisive',type:'SAMPLE WORLD TITLE MAIN EVENT',winner:{name:'Roman Reigns',portrait:'roman-reigns.png'},loser:'Sami Zayn',title:{name:'World Heavyweight Championship',belt:'wwe_world-heavyweight-championship-transparent.png'},description:'SAMPLE RESULT · NOT AN ACTUAL MATCH'},results:[{outcome:'decisive',type:'SAMPLE WOMEN’S CHAMPIONSHIP RESULT',winner:{name:'Liv Morgan',portrait:'liv-morgan.png'},loser:'Raquel Rodriguez',title:{name:'Women’s World Championship',belt:'wwe_womens-world-championship-transparent.png'},description:'DESIGN DEMONSTRATION ONLY'},{outcome:'decisive',type:'SAMPLE TAG TEAM RESULT',winner:{name:'Bron Breakker & Austin Theory',portraits:['bron-breakker.png','austin-theory.png']},loser:'two opponents',title:null,description:'SAMPLE TAG TEAM HEADSHOTS'}],fallout:[{headline:'SAMPLE — WRESTLEMANIA NIGHT ONE AFTERMATH',summary:'Illustrative storyline content only. Verified developments will be loaded after Night One.'}]},
 {number:2,main_event:{outcome:'decisive',type:'SAMPLE WWE CHAMPIONSHIP MAIN EVENT',winner:{name:'Sami Zayn',portrait:'sami-zayn.png'},loser:'Roman Reigns',title:{name:'Undisputed WWE Championship',belt:'wwe_undisputed-wwe-championship-transparent.png'},description:'SAMPLE RESULT · NOT AN ACTUAL MATCH'},results:[{outcome:'decisive',type:'SAMPLE INTERCONTINENTAL TITLE RESULT',winner:{name:'Chad Gable',portrait:'chad-gable.png'},loser:'Austin Theory',title:{name:'Intercontinental Championship',belt:'wwe_intercontinental-championship-transparent.png'},description:'DESIGN DEMONSTRATION ONLY'},{outcome:'no-contest',type:'SAMPLE NO-CONTEST MATCH',participants:[{name:'Chelsea Green',portrait:'chelsea-green.png'},{name:'Raquel Rodriguez',portrait:'raquel-rodriguez.png'}],description:'DEMONSTRATION · NO WINNER'}],fallout:[{headline:'SAMPLE — WRESTLEMANIA NIGHT TWO AFTERMATH',summary:'Illustrative storyline content only. Verified developments will be loaded after Night Two.'}]}];
 const empty=[{number:1,main_event:null,results:[],fallout:[]},{number:2,main_event:null,results:[],fallout:[]}];let nights=demo?demos:empty;
 const picAllowed=/^[a-z0-9-]{2,80}\.png$/,beltAllowed=/^[a-z0-9_-]{2,100}-transparent\.png$/;
 const __assetMap={"assets/approved-portraits/raquel-rodriguez.png":"__ISC_BASE__originals/shared/e98d72858a2d258b61bbaa237761c16897ce30608a81f0122555ae36175f6881.png","assets/approved-portraits/kelani-jordan.png":"__ISC_BASE__originals/shared/40e1c3b2fa0f7835882b3a27f32e359504562147d3d651fb59a98cc8b664d96e.png","assets/approved-portraits/b-fab.png":"__ISC_BASE__originals/shared/4fc1c066a42a12d7e8ce8ada43ebc180f6aa4463217fb7f38f1e180ac10d43c0.png","assets/approved-portraits/ricky-smokes.png":"__ISC_BASE__originals/shared/3eba8124ee10bd500299c0fb5bac2fb264811dfc6ab60f7b386b55b3d41c222f.png","assets/approved-portraits/chad-gable.png":"__ISC_BASE__originals/shared/21f0df07d6604322e8d70805499c83dd1f21848e958e5136fc37de02b70045fd.png","assets/approved-portraits/liv-morgan.png":"__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png","assets/approved-portraits/jackson-drake.png":"__ISC_BASE__originals/shared/7e0030b46f630c927ef759b8b05fe9061cfdbdb6a93c5fa2500ad026addb4407.png","assets/approved-portraits/austin-theory.png":"__ISC_BASE__originals/shared/3eeefc461273421fa9b7e048b1b1f41ebd3addada7dac540ab03617b3a517221.png","assets/approved-portraits/michin.png":"__ISC_BASE__originals/shared/e581571e288d5faaf7236bc6bc7f5ef3d355c8ad4d0fb9ec8e22a3d0dc69d2a7.png","assets/approved-portraits/zaria.png":"__ISC_BASE__originals/shared/d6f4f70cd98ed1e1e1bc1b65fc9583b64f8fec4f9b15f9080ff448fbe3579e7d.png","assets/approved-portraits/roman-reigns.png":"__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png","assets/approved-portraits/bron-breakker.png":"__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png","assets/approved-portraits/brad-baylor.png":"__ISC_BASE__originals/shared/c4f9d7071bb936c1f5cc4942d888cb0badda70f9710100cd44cddc241f5b9cbc.png","assets/approved-portraits/trick-williams.png":"__ISC_BASE__originals/shared/a2cd14fd61f506e06bc3ac30fcdb4d163c1f53aae3f727a24718609f1806504c.png","assets/approved-portraits/indi-hartwell.png":"__ISC_BASE__originals/shared/6385a19ee7f18cea291233a9224d98fb932cffb4810d7c95f4cabdac93f30ce8.png","assets/approved-portraits/sami-zayn.png":"__ISC_BASE__originals/shared/370c2ec04db0496edf4ba53b46ad6a0c4826b003886ad50c72bb07a66f27cc81.png","assets/approved-portraits/chelsea-green.png":"__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png","assets/approved-portraits/grayson-waller.png":"__ISC_BASE__originals/shared/ba5b42edd4124460057431542728b4084edace31ee1f6c317881038e0e067dff.png","assets/approved-belts/wwe_undisputed-wwe-championship-transparent.png":"__ISC_BASE__originals/shared/5566b3d55992daebc107e6e685805692c622e3e163d7d1afe8889463da513389.png","assets/approved-belts/wwe_wwe-womens-championship-transparent.png":"__ISC_BASE__originals/shared/feb51f15f302b319bf30c9374daf5ca26f98a54e7061c9ea59b64e48d29ee69d.png","assets/approved-belts/nxt_north_american-transparent.png":"__ISC_BASE__originals/shared/6c2c795d4c2de8a1633b52eef44b9b3f41a46d1aeda625e1bc1103c2d3c96a60.png","assets/approved-belts/nxt_tag_team-transparent.png":"__ISC_BASE__originals/shared/346eeb8d2aadcc3d8025ff06716a8d95cae3a661a28e8ed4678718cc851ac320.png","assets/approved-belts/nxt_womens_championship-transparent.png":"__ISC_BASE__originals/shared/e9f421e5b176afb9ef8eb6b72daba95a0266c558d69637ed38e4526e0cf232e9.png","assets/approved-belts/wwe_womens-intercontinental-championship-transparent.png":"__ISC_BASE__originals/shared/958ccd4b92ddacb6d2ec1eb62df3054f60502b15daf85d944d4f525817ff46a5.png","assets/approved-belts/wwe_world-tag-team-championship-transparent.png":"__ISC_BASE__originals/shared/44cb300d4469aec19e24a7cfa2459f7d8a9a5275c07b1b06f39dd05538afc478.png","assets/approved-belts/wwe_womens-world-championship-transparent.png":"__ISC_BASE__originals/shared/01d550a12cc1808d66fdd73a33c9e4d2f1f2d180f45075fb630c4f013bafc94d.png","assets/approved-belts/wwe_world-heavyweight-championship-transparent.png":"__ISC_BASE__originals/shared/aaf45a31d63eb4c054327f787570f1b222e8781677049a072236cc0ace390343.png","assets/approved-belts/wwe_united-states-championship-transparent.png":"__ISC_BASE__originals/shared/8ad59f53ea20caf1e73047f56cce9544ce9fd01d422d00bc7be57e1d138073c7.png","assets/approved-belts/wwe_womens-united-states-championship-transparent.png":"__ISC_BASE__originals/shared/ce59a17b864ae9c3a779f1819edf52c23aec2904e27a8ea3627e32a289555c0c.png","assets/approved-belts/wwe_intercontinental-championship-transparent.png":"__ISC_BASE__originals/shared/1611ac3c75639f46cb19f6fb73a3a2fa426664792037f810a0cd0d7319a20cfb.png","assets/approved-belts/nxt_championship-transparent.png":"__ISC_BASE__originals/shared/9ac55cdde4133802c03c195a50d40095c21f9fc6610e30cf07670f3514af703e.png","assets/approved-belts/nxt_womens_north_american-transparent.png":"__ISC_BASE__originals/shared/cc5757907edafc58908f5a713903d5be4d4b55f1a4ddd4509568bf48439f0d0c.png","assets/approved-belts/wwe_wwe-womens-tag-team-championship-transparent.png":"__ISC_BASE__originals/shared/62d4a620a864d1f74bc1226173072c118417bc2be21f541c29c9ee1466a75096.png","assets/approved-belts/wwe_wwe-tag-team-championship-transparent.png":"__ISC_BASE__originals/shared/666a6b165268c0da64bd614419b495ec65be5fc6444ef5bd1fd3544bd3b2678c.png"};const picPath=n=>typeof n==='string'&&picAllowed.test(n)?__assetMap['assets/approved-portraits/'+n]:null;const beltPath=n=>typeof n==='string'&&beltAllowed.test(n)?__assetMap['assets/approved-belts/'+n]:null;
 const mk=(tag,cl,content)=>{let e=document.createElement(tag);if(cl)e.className=cl;if(content!==undefined)e.textContent=String(content);return e};const sourceOK=s=>{try{const u=new URL(s);return u.protocol==='https:'&&(u.hostname==='wwe.com'||u.hostname.endsWith('.wwe.com'))}catch{return false}};
 function validResult(r){if(!r||r.verified!==true||!sourceOK(r.source_url)||!/^2027-\d\d-\d\d$/.test(r.source_date||'')||!['decisive','draw','no-contest'].includes(r.outcome))return false;if(r.outcome==='decisive')return typeof r.winner?.name==='string'&&r.winner.name.length>0&&r.winner.name.length<110&&typeof r.loser==='string'&&r.loser.length>0;if(!Array.isArray(r.participants)||r.participants.length<2||r.participants.length>20)return false;return r.participants.every(x=>typeof x?.name==='string'&&x.name.length>0&&x.name.length<110)}
 function validFallout(s){return s&&s.verified===true&&sourceOK(s.source_url)&&typeof s.headline==='string'&&s.headline.length>0&&s.headline.length<160&&typeof s.summary==='string'&&s.summary.length>0&&s.summary.length<360}
 function validate(data){if(!data||data.schema_version!==1||data.event_id!=='wrestlemania-43-2027'||!Array.isArray(data.nights)||data.nights.length!==2)return null;let out=[];const pt=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const fields=Object.fromEntries(pt.map(x=>[x.type,x.value]));const now=fields.year+'-'+fields.month+'-'+fields.day;for(let n of [1,2]){let row=data.nights.find(x=>x&&x.number===n);if(!row)return null;let date=row.event_date;if(typeof date!=='string'||!/^2027-\d\d-\d\d$/.test(date))return null;const held=date<=now;out.push({number:n,event_date:date,venue:typeof row.venue==='string'&&row.venue.length<140?row.venue:null,main_event:held&&validResult(row.main_event)?row.main_event:null,results:held&&Array.isArray(row.results)?row.results.filter(validResult).slice(0,30):[],fallout:held&&Array.isArray(row.fallout)?row.fallout.filter(validFallout).slice(0,25):[]})}return out}
 function inject(holder,people,multi){holder.replaceChildren();holder.className=holder.id==='mainPhoto'?'mainPhoto':'otherPhotos';if(multi){for(const person of people.slice(0,6)){let tile=mk('div','tile');let path=picPath(person.portrait);if(path){let img=mk('img');img.src=path;img.alt=person.name;img.onerror=()=>img.remove();tile.append(img)}tile.append(mk('span','',person.name));holder.append(tile)}return}let imgs=0;for(const person of people.slice(0,2)){const path=picPath(person.portrait);if(!path)continue;let img=mk('img');img.src=path;img.alt=person.name;img.onerror=()=>img.remove();holder.append(img);imgs++}if(imgs>1)holder.classList.add('two');if(!imgs)holder.append(mk('div','fallback','PORTRAIT PENDING'))}
 function renderBelt(holder,r){holder.replaceChildren();const path=beltPath(r?.title?.belt);if(!path)return;let img=mk('img');img.src=path;img.alt=String(r.title.name||'Championship')+' belt';img.onerror=()=>img.remove();holder.append(img)}
 function renderMatch(r,isMain){const prefix=isMain?'main':'other',el=id=>E(prefix+id);let root=E(isMain?'mainResult':'additional'),name=el('Name'),detail=el('Detail'),desc=el('Desc'),label=el('Label'),photos=E(isMain?'mainPhoto':'otherPhotos'),belt=el('Belt');root.classList.remove('titleResult','multi');belt.replaceChildren();if(!r){label.textContent=isMain?'MAIN EVENT · RESULT PENDING':'AWAITING VERIFIED RESULTS';name.textContent=isMain?'MAIN EVENT':'MATCH RESULTS';detail.textContent='OFFICIAL RESULTS PENDING';desc.textContent=isMain?'Results appear after official verification.':'Additional match results rotate here.';inject(photos,[],false);name.className=isMain?'mainName':'otherName';return}
 label.textContent=String(r.type||'MATCH RESULT').toUpperCase();desc.textContent=r.description||'';let people=[],isMulti=false;
 if(r.outcome==='decisive'){name.textContent=r.winner.name.toUpperCase();detail.textContent='def. '+r.loser;people=Array.isArray(r.winner.portraits)?r.winner.portraits.map(v=>({name:r.winner.name,portrait:v})):[r.winner]}
 else{name.textContent=r.outcome==='draw'?'MATCH ENDS IN A DRAW':'NO CONTEST';detail.textContent=r.participants.map(x=>x.name).join(' · ');people=r.participants;isMulti=isMain&&people.length>2;if(isMulti)root.classList.add('multi')}
 name.className=(isMain?'mainName':'otherName')+(name.textContent.length>(isMain?19:22)?' long':'');inject(photos,people,isMulti);if(r.title&&!isMulti){root.classList.add('titleResult');renderBelt(belt,r)}
 }
 function renderOther(){const row=nights[active];renderMatch(row.results.length?row.results[otherIndex%row.results.length]:null,false);E('otherStatus').textContent=row.results.length?'RESULT '+(otherIndex%row.results.length+1)+' / '+row.results.length:'RESULTS AS CONFIRMED'}
 function renderFallout(){const row=nights[active];let st=row.fallout.length?row.fallout[falloutIndex%row.fallout.length]:null;E('falloutStatus').textContent=row.fallout.length?'STORY '+(falloutIndex%row.fallout.length+1)+' / '+row.fallout.length:'AFTER THE EVENT';E('falloutTitle').textContent=st?st.headline:'THE AFTERMATH';E('falloutBody').textContent=st?st.summary:'Confirmed championship developments, rivalries and key moments from this night will appear here.'}
 function render(){let row=nights[active],nn=active?'TWO':'ONE';E('nightTop').textContent='NIGHT '+nn;E('mainHeading').textContent='NIGHT '+nn+' · MAIN EVENT RESULT';E('mainStatus').textContent=row.main_event?(demo?'VISUAL DEMO':'SOURCE-VERIFIED RESULT'):'AWAITING VERIFIED RESULTS';E('dateBar').textContent=demo?'WRESTLEMANIA 43 · APRIL 2027':row.event_date?row.event_date+' · RIYADH':'WRESTLEMANIA 43 · APRIL 2027';E('venue').textContent=(row.venue||'RIYADH, SAUDI ARABIA · VENUE TO BE ANNOUNCED').toUpperCase();renderMatch(row.main_event,true);renderOther();renderFallout()}
 if(demo){B.classList.add('demo');E('reviewNotice').textContent='SAMPLE RESULTS · NOT ACTUAL WRESTLEMANIA 43 OUTCOMES';E('tickerText').textContent='DESIGN DEMONSTRATION ONLY ◆ WRESTLEMANIA 43 ◆ NIGHT ONE & NIGHT TWO ◆ SAMPLE MATCH RESULTS ◆ NOT OFFICIAL ◆ DESIGN DEMONSTRATION ONLY ◆ '}
 async function refresh(){if(demo)return;try{let r=await fetch('wrestlemania43-results-data.json?ts='+Date.now(),{cache:'no-store'});if(!r.ok)throw Error('fetch');let next=validate(await r.json());if(!next)return;nights=next;otherIndex=0;falloutIndex=0;render()}catch{/* Retain last valid data, or empty state. */}}
 render();refresh();if(nightParam!=='1'&&nightParam!=='2')setInterval(()=>{active=(active+1)%2;otherIndex=0;falloutIndex=0;render()},14000);setInterval(()=>{otherIndex++;renderOther()},10000);setInterval(()=>{falloutIndex++;renderFallout()},12000);setInterval(refresh,300000);
 window.__wm43ResultsQA={state:()=>({demo,night:active+1,main:!!nights[active].main_event,other:nights[active].results.length,fallout:nights[active].fallout.length}),night:n=>{active=n===2?1:0;otherIndex=0;falloutIndex=0;render()},nextResult:()=>{otherIndex++;renderOther()},nextFallout:()=>{falloutIndex++;renderFallout()},setDemoMulti:()=>{if(demo){nights[active].main_event={outcome:'no-contest',type:'SAMPLE MULTI-WRESTLER MATCH',participants:[{name:'Roman Reigns',portrait:'roman-reigns.png'},{name:'Sami Zayn',portrait:'sami-zayn.png'},{name:'Trick Williams',portrait:'trick-williams.png'},{name:'Liv Morgan',portrait:'liv-morgan.png'},{name:'Chad Gable',portrait:'chad-gable.png'},{name:'Raquel Rodriguez',portrait:'raquel-rodriguez.png'}]};render()}}};
})();
</script></body></html>