.mainResult{border:2px solid #f7d188!important;box-shadow:inset 0 0 34px #e6b76324,0 0 19px #f4c56d75!important;background:radial-gradient(ellipse at 75% 55%,#c99b5040,transparent 70%),linear-gradient(115deg,#36230e,#090b0c 65%,#2c210f)!important}
.additional{border:2px solid #e3ba6d!important;box-shadow:0 0 13px #e5ae4e45!important;background:linear-gradient(120deg,#2c210f,#07090c 66%,#302210)!important}
.section h2,.resultsHeading h2,.falloutHeading h2{color:#fff3ce!important;text-shadow:0 0 11px #e1b96c7a!important}
.fallout{background:linear-gradient(90deg,#39270f,#0a0b0d 60%,#2a210f)!important;border-left-color:#f4cf7b!important}
.ticker{box-shadow:0 -4px 17px #efbc6075!important}
.mainPhoto img,.otherPhotos img{filter:drop-shadow(0 0 12px #f5d18d60)!important}

/* WM43 Night One V3 — Riyadh sapphire/gold architectural broadcast treatment; CSS only */
#board{background:#061124}
.tint{background:linear-gradient(180deg,#020916de 0%,#07162cd0 21%,#082a4a9c 38%,#040c1fe6 64%,#020711f9 100%)}
#board:before{content:'';position:absolute;inset:170px 0 66px;z-index:2;pointer-events:none;opacity:.33;background:repeating-linear-gradient(60deg,transparent 0 37px,#e7b95d26 38px,#e7b95d26 39px,transparent 40px 76px),repeating-linear-gradient(-60deg,transparent 0 37px,#e7b95d26 38px,#e7b95d26 39px,transparent 40px 76px);mask-image:linear-gradient(to bottom,transparent,#000 18%,#000 84%,transparent)}
#board:after{content:'';position:absolute;inset:195px -200px 75px;z-index:2;pointer-events:none;background:conic-gradient(from 225deg at 50% 5%,transparent 0deg,#74baff33 15deg,transparent 30deg,#ffdc8238 46deg,transparent 60deg,#a7d7ff24 79deg,transparent 100deg);animation:royalLights 11s ease-in-out infinite alternate;filter:blur(11px)}
@keyframes royalLights{0%{transform:translateX(-25px);opacity:.48}100%{transform:translateX(25px);opacity:.9}}
.beam{background:#d6b76d;opacity:.36;filter:blur(40px);animation:beamPulse 5s ease-in-out infinite alternate}.beam.right{background:#4e9de5;animation-delay:-2s}
@keyframes beamPulse{to{opacity:.62;transform:rotate(4deg)}}
.brandkicker{color:#ffdc91}
.barMask{background:linear-gradient(180deg,#06112700,#061127dc 24%,#061125f7 60%,#030917fe)}
