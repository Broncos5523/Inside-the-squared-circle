/* REVIEW ONLY — WRESTLEMANIA 43 HEADER LOGO CLEARANCE — SINGLE-SCOPE FIX.
   Preserve source art, results panels, frame/ticker, logic and approved assets. */
.brand{top:-1px;height:170px}
.brandkicker{top:166px}
