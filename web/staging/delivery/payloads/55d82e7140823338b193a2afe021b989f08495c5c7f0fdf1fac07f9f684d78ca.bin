<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#061b0d"><title>Man Cave Sports Book — WrestleMania 43 Results &amp; Fallout — Review</title><style>
*{box-sizing:border-box}html,body{margin:0;height:100%;width:100%;overflow:hidden;background:#060705;color:#fff}body{font-family:Arial,Helvetica,sans-serif;display:grid;place-items:center}#board{width:720px;height:1280px;position:relative;isolation:isolate;overflow:hidden;background:#06140a;transform-origin:center}
.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.tint{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,#020301ce 0%,#061407d9 21%,#133817ac 38%,#040806e5 62%,#010302fc 100%)}.beam{position:absolute;z-index:2;top:205px;height:575px;width:100px;filter:blur(51px);opacity:.18;background:#e7c260}.beam.left{left:-72px;transform:rotate(-10deg)}.beam.right{right:-72px;transform:rotate(10deg)}
.brand{position:absolute;z-index:6;top:0;left:48px;width:624px;height:187px;object-fit:contain;filter:drop-shadow(0 5px 7px #000e)}.brandkicker{position:absolute;z-index:5;top:179px;left:0;width:100%;text-align:center;color:#f4da99;letter-spacing:3px;font-size:13px;font-weight:900;text-shadow:0 2px 4px #000}
.eventplate{position:absolute;z-index:5;top:205px;left:114px;width:492px;height:143px;display:grid;place-items:center}.eventplate:before{content:'';position:absolute;inset:4px;background:radial-gradient(ellipse,#fbd88745,transparent 73%);filter:blur(14px)}.eventplate img{position:relative;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 3px 4px #000e) drop-shadow(0 0 10px #f5c34f6a)}
.barMask{position:absolute;z-index:4;left:0;right:0;top:310px;height:153px;pointer-events:none;background:linear-gradient(180deg,#06150900 0%,#061509dc 24%,#051109f6 53%,#030a05fe 100%)}
.resultsbar{position:absolute;z-index:6;top:350px;left:84px;right:84px;height:90px;text-align:center;background:linear-gradient(90deg,transparent,#3e2b0ddc 16%,#0e2611eb 52%,#3e2b0ddc 85%,transparent);border-top:2px solid #c89c44;border-bottom:2px solid #c89c44;padding:9px 0 0}.resultsbar h1{margin:0;font:900 36px/1.04 Impact,'Arial Black',sans-serif;letter-spacing:2.9px;color:#ffefce;text-shadow:0 3px #000,0 0 12px #d8ab535e}.resultsbar p{margin:9px 0 0;font-weight:900;letter-spacing:2px;color:#e6cc8e;font-size:13px}
.frame{position:absolute;z-index:7;top:461px;left:19px;right:19px;height:736px;padding:6px;background:linear-gradient(138deg,#ffedb0,#b88b42 4%,#1b2719 9%,#142118 92%,#9e762d 97%,#ffebac);clip-path:polygon(0 17px,17px 0,calc(100% - 17px) 0,100% 17px,100% calc(100% - 19px),calc(100% - 19px) 100%,19px 100%,0 calc(100% - 19px));box-shadow:0 0 30px #d9ae4250}.inner{height:100%;clip-path:inherit;background:linear-gradient(148deg,#122f1c,#080b0c 41%,#0b180d 72%,#040706);padding:10px 12px 9px;border:1px solid #6e773d}
.topstrip{height:29px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 10px;background:linear-gradient(90deg,#386d2f,#0d2414 33%,#153518 72%,#58722d);border-left:3px solid #efcb75;border-right:3px solid #e7c373;color:#f9e8ba;font-size:11px;font-weight:900;letter-spacing:1px}.topstrip .nightlabel{font-size:13px;color:#fff4ce}
.section{height:38px;display:flex;align-items:center;justify-content:space-between;padding:0 3px;gap:5px}.section h2{margin:0;font:900 23px Impact,'Arial Black',sans-serif;letter-spacing:1px;color:#fff4da;text-shadow:0 2px #000}.section small{font-size:10px;font-weight:900;color:#dabb75;text-align:right;letter-spacing:.65px}
.mainResult{height:274px;position:relative;overflow:hidden;border:2px solid #ae8a48;background:radial-gradient(ellipse at 72% 55%,#5c7b344a,transparent 67%),linear-gradient(135deg,#274021,#080b0c 60%,#22351b);box-shadow:inset 0 0 23px #000c}.mainResult:before{content:'';position:absolute;top:5px;left:10px;right:10px;height:3px;background:linear-gradient(90deg,transparent,#ffe9af,transparent)}
.mainLabel{position:absolute;z-index:5;top:17px;left:16px;max-width:414px;font-size:12px;color:#e0c688;letter-spacing:1.5px;font-weight:900;text-shadow:0 2px #000}.mainCopy{position:absolute;left:16px;top:48px;bottom:14px;width:389px;z-index:5;display:flex;flex-direction:column;justify-content:center;gap:9px;overflow:hidden}.mainName{font:900 51px/.99 Impact,'Arial Black',sans-serif;color:#fff4dc;letter-spacing:.45px;text-transform:uppercase;text-shadow:0 3px 2px #000,0 0 10px #000;max-height:154px;overflow:hidden;overflow-wrap:break-word}.mainName.long{font-size:40px}.mainDetail{font-size:18px;font-weight:900;color:#f7e7b9;text-shadow:0 2px 4px #000;max-height:65px;overflow:hidden}.mainDesc{font-size:12px;font-weight:800;color:#d3d8c0;max-height:36px;overflow:hidden}
.mainPhoto{position:absolute;right:12px;top:68px;bottom:9px;width:219px;z-index:3;display:flex;align-items:end;justify-content:center;overflow:hidden;border-left:1px solid #eac06e33}.mainPhoto img{max-width:100%;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 4px 5px #000)}.mainPhoto.two img{width:50%;height:100%}.mainResult.titleResult .mainPhoto{top:94px}.mainBelt{position:absolute;z-index:8;top:9px;right:22px;width:178px;height:72px;display:grid;place-items:center;background:radial-gradient(ellipse,#ead18a47,transparent 75%)}.mainBelt img{max-width:100%;max-height:69px;object-fit:contain;filter:brightness(1.6) contrast(1.11) drop-shadow(0 2px 4px #000)}
.mainResult.multi .mainCopy{position:absolute;top:35px;left:16px;right:16px;bottom:auto;width:auto;height:45px;align-items:center;justify-content:center}.mainResult.multi .mainName{font-size:29px;max-height:32px}.mainResult.multi .mainDetail,.mainResult.multi .mainDesc{display:none}.mainResult.multi .mainPhoto{left:14px;right:14px;width:auto;top:91px;bottom:15px;border:none;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:7px;align-items:stretch}.mainResult.multi .mainPhoto .tile{min-width:0;min-height:0;border:1px solid #b29a5c;position:relative;overflow:hidden;background:#153520}.mainResult.multi .mainPhoto .tile img{position:absolute;width:100%;height:100%;object-fit:contain;object-position:center bottom}.mainResult.multi .mainPhoto .tile span{position:absolute;bottom:0;left:0;right:0;background:#020603df;padding:3px 1px;text-align:center;font:900 10px Arial,sans-serif;color:#fff3db}
.fallback{border:1px solid #92743c;background:#1d321dd9;color:#eddfbd;font:900 15px Impact,'Arial Black',sans-serif;letter-spacing:1px;text-align:center;display:grid;place-items:center;width:85%;height:58%;align-self:center}
.resultsHeading{height:36px;margin-top:7px;display:flex;align-items:center;justify-content:space-between;padding:0 3px}.resultsHeading h2{margin:0;font:900 23px Impact,'Arial Black',sans-serif;color:#fff4d9;letter-spacing:1px}.resultsHeading small{font-size:10px;font-weight:900;color:#d5be80}
.additional{height:142px;border:2px solid #8e713b;overflow:hidden;position:relative;background:radial-gradient(ellipse at 80% 50%,#456b314d,transparent 64%),linear-gradient(135deg,#1f391f,#050706 59%,#182b13)}.otherCopy{position:absolute;z-index:5;left:13px;top:8px;bottom:7px;width:437px;display:flex;flex-direction:column;gap:4px;justify-content:center;overflow:hidden}.otherLabel{color:#ddc484;font-size:11px;font-weight:900;letter-spacing:1px}.otherName{font:900 29px/.99 Impact,'Arial Black',sans-serif;color:#fff3dc;text-shadow:0 3px 3px #000;max-height:63px;overflow:hidden;overflow-wrap:break-word;text-transform:uppercase}.otherName.long{font-size:23px}.otherDetail{font-size:13px;font-weight:900;color:#f6e8c6;max-height:28px;overflow:hidden}.otherDesc{font-size:11px;font-weight:800;color:#cad4b9;max-height:25px;overflow:hidden}.otherPhotos{position:absolute;z-index:2;right:8px;top:31px;bottom:5px;width:150px;display:flex;justify-content:center;align-items:end;overflow:hidden;border-left:1px solid #d9c17933}.otherPhotos img{height:100%;width:100%;object-fit:contain;object-position:center bottom}.otherPhotos.two img{width:50%}.otherBelt{position:absolute;z-index:8;top:4px;right:11px;width:137px;height:39px;display:grid;place-items:center;background:radial-gradient(ellipse,#ffeba244,transparent 75%)}.otherBelt img{max-width:135px;max-height:38px;object-fit:contain;filter:brightness(1.6) drop-shadow(0 2px 3px #000)}
.falloutHeading{height:32px;margin-top:7px;display:flex;align-items:center;justify-content:space-between;padding:0 4px}.falloutHeading h2{font:900 21px Impact,'Arial Black',sans-serif;color:#f7dea7;letter-spacing:1px;margin:0}.falloutHeading small{font-size:10px;font-weight:900;color:#cfb77b}
.fallout{height:77px;padding:8px 12px;border-left:4px solid #e5b956;border-right:2px solid #ba974a;overflow:hidden;background:linear-gradient(90deg,#2d3d1f,#0b100d 56%,#203317)}.fallout h3{font:900 20px/1.04 Impact,'Arial Black',sans-serif;color:#fff2ce;margin:0 0 5px}.fallout p{font-size:12px;font-weight:800;color:#e1dfc6;line-height:1.2;margin:0;max-height:44px;overflow:hidden}
.venue{height:35px;margin-top:8px;display:grid;place-items:center;text-align:center;padding:0 8px;font-size:13px;font-weight:900;letter-spacing:.8px;color:#fff1c6;text-shadow:0 2px #000;border-left:3px solid #e7cb77;border-right:3px solid #e7cb77;background:linear-gradient(90deg,#5a7429,#1b3d20 24%,#162f18 75%,#666d26)}
.reviewNotice{position:absolute;bottom:70px;left:0;right:0;z-index:6;text-align:center;color:#f2e1a6;font-weight:900;letter-spacing:.7px;font-size:10px;text-shadow:0 2px #000}.ticker{position:absolute;z-index:9;bottom:0;left:0;right:0;height:70px;border-top:3px solid #e7bd60;display:flex;overflow:hidden;background:linear-gradient(90deg,#1b4b20,#98702a 18%,#101b0d 43%,#040504)}.tickerLogo{width:140px;flex:0 0 140px;display:grid;place-items:center;padding:4px 6px;border-right:2px solid #c9ab5d;background:linear-gradient(90deg,#2a5827,#386f33)}.tickerLogo img{height:55px;max-width:112px;object-fit:contain;filter:drop-shadow(0 2px 4px #000)}.tickerTrack{flex:1;overflow:hidden;display:flex;align-items:center;white-space:nowrap}.tickerTrack span{padding-left:18px;font-size:18px;font-weight:900;color:#f2e3bb;display:inline-block;animation:move 42s linear infinite}@keyframes move{to{transform:translateX(-50%)}}.sampleFlag{display:none;position:absolute;z-index:11;top:440px;left:128px;right:128px;text-align:center;font-size:11px;letter-spacing:1px;font-weight:900;color:#30200a;background:#f7cc78;border:1px solid #fcebbf}.demo .sampleFlag{display:block}.demo .topstrip{box-shadow:inset 0 0 0 1px #c6a75577}#board:after{position:absolute;content:'';z-index:12;inset:0;pointer-events:none;box-shadow:inset 0 0 0 2px #aa7e38,inset 0 0 24px #000}
