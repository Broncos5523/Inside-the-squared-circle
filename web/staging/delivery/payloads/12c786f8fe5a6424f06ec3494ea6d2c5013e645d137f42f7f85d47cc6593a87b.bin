<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Worlds Collide Preview V1</title><style>
*{box-sizing:border-box}html,body{margin:0;background:#06070c;color:white;font-family:Arial,sans-serif;overflow-x:hidden}#holder{width:720px;height:1280px;position:relative;margin:0 auto}#board{width:720px;height:1280px;position:absolute;top:0;left:0;overflow:hidden;background:#05070b}.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(#02040bb8,#02050aeb 30%,#040609f8)}.brand{position:absolute;top:8px;left:125px;width:470px;height:103px;object-fit:contain}.event{position:absolute;top:112px;left:108px;width:504px;height:138px;object-fit:contain;filter:drop-shadow(0 0 12px #b5cfff)}.banner{position:absolute;top:255px;left:40px;width:640px;text-align:center;padding:13px;border-block:2px solid #a7bce2;background:linear-gradient(90deg,#11182a,#324969,#11182a);font:900 30px Impact,Arial Black,sans-serif;letter-spacing:3px}.matches{position:absolute;top:338px;left:25px;width:670px;display:grid;gap:13px}.match{height:244px;border:2px solid #96accd;border-radius:8px;background:linear-gradient(110deg,#19253bea,#070a11f5 55%,#19253bea);position:relative;overflow:hidden;box-shadow:0 0 13px #7894bd44}.heading{height:42px;background:#263c5e;border-bottom:2px solid #9ab4dc;text-align:center;font:900 25px Impact,Arial Black,sans-serif;letter-spacing:1.5px;padding:7px}.versus{position:relative;height:160px}.fighter{position:absolute;bottom:0;width:218px;height:160px;object-fit:contain;object-position:bottom;filter:drop-shadow(0 0 7px #000)}.left{left:0}.right{right:0;transform:scaleX(-1)}.belt{position:absolute;left:237px;top:26px;width:192px;height:111px;object-fit:contain;filter:brightness(1.7) contrast(1.15) drop-shadow(0 0 10px #f9dca2)}.names{height:38px;text-align:center;font-weight:900;font-size:17px;padding:9px;background:#080d18}.names strong{color:#e2c27d;margin:0 16px}.footer{position:absolute;bottom:0;width:720px;height:68px;background:#111b2d;border-top:3px solid #b5c8e7;display:flex;align-items:center}.footer img{width:145px;height:55px;object-fit:contain;margin:0 12px}.footer span{font-size:15px;font-weight:900;letter-spacing:1px}.disclaimer{position:absolute;bottom:72px;width:100%;text-align:center;font-size:10px;color:#bfc9d9}
</style></head><body><div id="holder"><main id="board"><img class="arena" src="__ISC_BASE__originals/shared/b99859d109c44e72bc11c64c6abc3d41c4fd08ec5984706ec276ba72d82480e7.jpg"><div class="shade"></div><img class="brand" src="__ISC_BASE__originals/shared/6b8d91042edf7d48598c32f1b46d6451dfc9cc0c2d49eeb0e1a0be7b38d8fc13.png"><img class="event" src="__ISC_BASE__originals/shared/fd0bc1867d8cdc815d91d58b952be13274fb1983b23b7a1ba5fa83c72459b0b7.png"><div class="banner">MATCH CARD PREVIEW</div><div class="matches"><section class="match"><div class="heading">NXT CHAMPIONSHIP</div><div class="versus"><img class="fighter left" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img class="belt" src="__ISC_BASE__originals/shared/1a24a2994a551ce73f263bf627ba3e96d1804ffc0f93a75f261d83eb71cc568a.png"><img class="fighter right" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"></div><div class="names">COMPETITOR TBA <strong>VS</strong> COMPETITOR TBA</div></section><section class="match"><div class="heading">NXT WOMEN’S CHAMPIONSHIP</div><div class="versus"><img class="fighter left" src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><img class="belt" src="__ISC_BASE__originals/shared/caa4dcd0422b072ea1b5efca5b263083871808144656597d438f1290db992439.png"><img class="fighter right" src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"></div><div class="names">COMPETITOR TBA <strong>VS</strong> COMPETITOR TBA</div></section><section class="match"><div class="heading">NORTH AMERICAN CHAMPIONSHIP</div><div class="versus"><img class="fighter left" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img class="belt" src="__ISC_BASE__originals/shared/6c2c795d4c2de8a1633b52eef44b9b3f41a46d1aeda625e1bc1103c2d3c96a60.png"><img class="fighter right" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"></div><div class="names">COMPETITOR TBA <strong>VS</strong> COMPETITOR TBA</div></section></div><div class="disclaimer">LAYOUT DEMONSTRATION · MATCHES AND ENTRANTS NOT CONFIRMED</div><footer class="footer"><img src="__ISC_BASE__originals/shared/fd0bc1867d8cdc815d91d58b952be13274fb1983b23b7a1ba5fa83c72459b0b7.png"><span>INSIDE THE SQUARED CIRCLE · WORLDS COLLIDE</span></footer></main></div><script>function resize(){let s=Math.min(innerWidth/720,1);let h=document.getElementById('holder');h.style.width=(720*s)+'px';h.style.height=(1280*s)+'px';document.getElementById('board').style.transform='scale('+s+')';document.getElementById('board').style.transformOrigin='top left';}addEventListener('resize',resize);resize();</script></body></html>