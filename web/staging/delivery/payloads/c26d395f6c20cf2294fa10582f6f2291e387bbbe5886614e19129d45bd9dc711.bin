<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><meta charset="utf-8"><title>NXT Deadline Preview V1</title><style>*{box-sizing:border-box}html,body{margin:0;background:#030711;color:white;font-family:Arial,sans-serif}#viewport{width:720px;margin:0 auto;position:relative}#board{width:720px;height:1280px;position:relative;overflow:hidden;background:linear-gradient(180deg,rgba(2,6,18,.10),rgba(2,5,15,.92) 42%,rgba(2,5,15,.97)),url("__ISC_BASE__originals/shared/3db1b2a4ebf15c4a8f87abce3cd239a2576dfc45babddc444395a277bb19e4a5.jpg") center/cover no-repeat}.brand{position:absolute;top:16px;right:22px;width:310px;height:105px;object-fit:contain}.event{position:absolute;top:118px;left:110px;width:500px;height:170px;object-fit:contain;filter:drop-shadow(0 0 15px #e6c367)}.heading{position:absolute;top:291px;left:22px;right:22px;text-align:center;background:linear-gradient(90deg,transparent,#181d2d 15%,#303747 50%,#181d2d 85%,transparent);border-top:2px solid #c9a95e;border-bottom:2px solid #c9a95e;padding:10px;font-size:28px;font-weight:900;letter-spacing:3px}.sub{font-size:12px;color:#dfc98e;letter-spacing:2px;margin-top:4px}.panel{position:absolute;left:26px;width:668px;background:linear-gradient(120deg,rgba(17,24,42,.91),rgba(4,9,20,.94));border:2px solid #9b8a60;border-radius:14px;box-shadow:0 0 20px #0009;padding:12px}.panel h2{font-size:19px;margin:0 0 9px;text-transform:uppercase;letter-spacing:1.3px;color:#f6e7bd}.entrants{display:flex;justify-content:space-between;gap:5px}.entrant{width:120px;height:135px;background:linear-gradient(#273148,#080b14);border:1px solid #6d7890;overflow:hidden;position:relative}.entrant img{width:100%;height:111px;object-fit:contain;object-position:center bottom}.entrant span{display:block;text-align:center;font-size:10px;letter-spacing:.5px;background:#1c2536;padding:4px 0}.match{display:flex;align-items:center;justify-content:space-between;height:122px;gap:6px}.portrait{width:174px;height:120px;object-fit:contain;object-position:center bottom;background:#182032;border:1px solid #65718b}.belt{width:225px;height:110px;object-fit:contain;filter:brightness(1.5) contrast(1.12) drop-shadow(0 0 9px #dcb34f)}.ticker{position:absolute;bottom:0;left:0;width:720px;height:58px;background:#0c1325;border-top:3px solid #d7b65c;display:flex;align-items:center;gap:12px;padding:7px 18px;font-weight:bold;font-size:15px}.ticker img{height:43px;width:115px;object-fit:contain}.note{font-size:10px;color:#b6c2d4;text-align:center;margin-top:4px}</style></head><body><div id="viewport"><div id="board"><img class="brand" src="__ISC_BASE__originals/shared/6b8d91042edf7d48598c32f1b46d6451dfc9cc0c2d49eeb0e1a0be7b38d8fc13.png"><img class="event" src="__ISC_BASE__originals/shared/575f4a32405920334812d808ed4e6055d54ed6b05aea11f2a9213207200a2c6b.png"><div class="heading">MATCH CARD PREVIEW<div class="sub">NXT DEADLINE · IRON SURVIVOR CHALLENGE</div></div><section class="panel" style="top:376px;height:204px"><h2>Men's Iron Survivor Challenge</h2><div class="entrants"><div class="entrant"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><span>ENTRANT 1</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><span>ENTRANT 2</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><span>ENTRANT 3</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><span>ENTRANT 4</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><span>ENTRANT 5</span></div></div></section><section class="panel" style="top:592px;height:204px"><h2>Women's Iron Survivor Challenge</h2><div class="entrants"><div class="entrant"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><span>ENTRANT 1</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><span>ENTRANT 2</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><span>ENTRANT 3</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><span>ENTRANT 4</span></div><div class="entrant"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><span>ENTRANT 5</span></div></div></section><section class="panel" style="top:808px;height:199px"><h2>NXT Championship Matchup Spotlight</h2><div class="match"><img class="portrait" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"><img class="belt" src="__ISC_BASE__originals/shared/1a24a2994a551ce73f263bf627ba3e96d1804ffc0f93a75f261d83eb71cc568a.png"><img class="portrait" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"></div></section><section class="panel" style="top:1018px;height:184px"><h2>NXT Women's Championship Matchup</h2><div class="match" style="height:110px"><img class="portrait" style="height:106px" src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"><img class="belt" style="height:103px" src="__ISC_BASE__originals/shared/caa4dcd0422b072ea1b5efca5b263083871808144656597d438f1290db992439.png"><img class="portrait" style="height:106px" src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"></div></section><div class="ticker"><img src="__ISC_BASE__originals/shared/575f4a32405920334812d808ed4e6055d54ed6b05aea11f2a9213207200a2c6b.png"><span>INSIDE THE SQUARED CIRCLE &nbsp; | &nbsp; NXT DEADLINE PREVIEW</span></div></div></div><script>function fit(){let v=document.getElementById('viewport');let s=Math.min(1,window.innerWidth/720);v.style.width=(720*s)+'px';v.style.height=(1280*s)+'px';document.getElementById('board').style.transform='scale('+s+')';document.getElementById('board').style.transformOrigin='top left';}addEventListener('resize',fit);fit();</script></body></html>