.barMask{background:linear-gradient(180deg,#06142b00 0%,#06142bdc 24%,#06142bf6 53%,#030918fe 100%)!important}
.resultsbar{background:linear-gradient(90deg,transparent,#a34715cc 16%,#09244ceb 52%,#a34715cc 85%,transparent)!important;border-color:#ff842c!important}
.resultsbar h1{color:#fff5eb!important;text-shadow:0 3px #000,0 0 12px #ff782b75!important}
.resultsbar p{color:#ffb67b!important}
.frame{background:linear-gradient(138deg,#ffb06a,#f47521 4%,#102c53 9%,#091b38 92%,#fa7420 97%,#ffd09d)!important;box-shadow:0 0 30px #ff7c3455!important}
.inner{background:linear-gradient(148deg,#102d52,#060d1f 41%,#091d39 72%,#030917)!important;border-color:#d36c31!important}
.topstrip{background:linear-gradient(90deg,#d35b19,#0a254d 33%,#0b2e5a 72%,#eb7622)!important;border-left-color:#ff9b42!important;border-right-color:#ff9b42!important;color:#ffe0c5!important}
.topstrip .nightlabel,.section h2,.resultsHeading h2,.falloutHeading h2{color:#fff4ec!important}
.section small,.resultsHeading small,.falloutHeading small{color:#ffad76!important}
.mainResult{border-color:#ff7925!important;background:radial-gradient(ellipse at 72% 55%,#2464a04f,transparent 67%),linear-gradient(135deg,#133965,#060d1f 60%,#0d2d56)!important}
.mainResult:before{background:linear-gradient(90deg,transparent,#ff9145,transparent)!important}
.mainLabel,.otherLabel{color:#ffb781!important}.mainName,.otherName{color:#fff6f0!important}.mainDetail,.otherDetail{color:#ffddc6!important}.mainDesc,.otherDesc{color:#c9dcf4!important}
.mainPhoto{border-left-color:#ff883744!important}.mainBelt{background:radial-gradient(ellipse,#ff8c3340,transparent 75%)!important}
.mainResult.multi .mainPhoto .tile{border-color:#ff8c45!important;background:#0b2c55!important}
.mainResult.multi .mainPhoto .tile span{background:#041127e9!important;color:#fff!important}
.fallback{border-color:#e57732!important;background:#0b2c55!important;color:#ffdbbf!important}
.additional{border-color:#2b91ff!important;background:radial-gradient(ellipse at 80% 50%,#276ab14d,transparent 64%),linear-gradient(135deg,#103963,#040b1b 59%,#0d2d54)!important}
.otherPhotos{border-left-color:#ff9c5444!important}.otherBelt{background:radial-gradient(ellipse,#ff963b3e,transparent 75%)!important}
.falloutHeading h2{color:#fff0e7!important}.fallout{border-left-color:#ff7d27!important;border-right-color:#2b91ff!important;background:linear-gradient(90deg,#173b66,#07152d 56%,#102c52)!important}
.fallout h3{color:#ffcfaa!important}.fallout p{color:#d6e6fa!important}
.venue{color:#fff0e2!important;border-left-color:#ff8b35!important;border-right-color:#2b91ff!important;background:linear-gradient(90deg,#ad4c1d,#0e3462 24%,#0a2852 75%,#b9521e)!important}
.reviewNotice{color:#ffb47d!important}.ticker{border-top-color:#ff832b!important;background:linear-gradient(90deg,#0c2b55,#d25b1e 18%,#0a1b38 43%,#030916)!important}
.tickerLogo{border-right-color:#ff852f!important;background:linear-gradient(90deg,#0d376d,#154b83)!important}

/* V4: CSS-only WarGames steel cage mesh; original arena artwork remains intact. */
.tint::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:.32;background-image:repeating-linear-gradient(45deg,transparent 0px,transparent 28px,rgba(181,205,238,.28) 29px,rgba(181,205,238,.28) 30px,transparent 31px,transparent 59px),repeating-linear-gradient(-45deg,transparent 0px,transparent 28px,rgba(181,205,238,.28) 29px,rgba(181,205,238,.28) 30px,transparent 31px,transparent 59px);background-size:60px 60px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.65),black 35%,black 90%,rgba(0,0,0,.75));}
/* SummerSlam-style title display: large borderless belt below winner copy, never over portrait. */
.additional.titleResult .otherBelt{top:65px!important;left:17px!important;right:auto!important;width:214px!important;height:66px!important;display:flex!important;justify-content:flex-start!important;align-items:center!important;background:none!important;border:none!important;box-shadow:none!important;}
.additional.titleResult .otherBelt img{max-width:210px!important;max-height:65px!important;width:100%;height:100%;object-fit:contain!important;object-position:left center!important;filter:drop-shadow(0 3px 4px #000)!important;}
.additional.titleResult .otherCopy{top:4px!important;bottom:auto!important;height:61px!important;justify-content:flex-start!important;gap:3px!important;width:425px!important;}
.additional.titleResult .otherDetail{font-size:12px!important;max-height:19px!important;}
.additional.titleResult .otherDesc{display:none!important;}
.additional.titleResult .otherPhotos{top:12px!important;bottom:3px!important;right:12px!important;width:145px!important;}
.mainResult.titleResult:not(.wargames) .mainBelt{top:176px!important;left:20px!important;right:auto!important;width:245px!important;height:78px!important;background:none!important;border:none!important;}
.mainResult.titleResult:not(.wargames) .mainBelt img{max-width:240px!important;max-height:75px!important;filter:drop-shadow(0 3px 5px #000)!important;}
.mainResult.titleResult:not(.wargames) .mainCopy{top:48px!important;bottom:auto!important;height:120px!important;justify-content:flex-start!important;}
.mainResult.titleResult:not(.wargames) .mainPhoto{top:65px!important;}
</style></head><body><main id="board">
<img class="arena" src="assets/user-survivor-series-arena-original.png" alt="User-approved Survivor Series arena"><div class="tint"></div><div class="beam left"></div><div class="beam right"></div>
<img class="brand" src="assets/user-approved-mancave-logo.png" alt="Man Cave Sports Book Presents Inside the Squared Circle"><div class="brandkicker">WWE PREMIUM LIVE EVENT · SURVIVOR SERIES</div><div class="eventplate"><img src="assets/user-survivor-series-wargames-houston-logo.png" alt="User-provided Survivor Series WarGames Houston logo"></div><div class="barMask"></div>
<div class="resultsbar"><h1>RESULTS &amp; FALLOUT</h1><p id="dateBar">SURVIVOR SERIES · DATE TO BE ANNOUNCED</p></div><div class="sampleFlag">SAMPLE OUTCOMES · DESIGN DEMONSTRATION</div>
<section class="frame"><div class="inner"><div class="topstrip"><span>SURVIVOR SERIES · WARGAMES</span><span class="nightlabel" id="nightTop">WARGAMES</span></div>
<div class="section"><h2 id="mainHeading">WARGAMES · FEATURED RESULTS</h2><small id="mainStatus">AWAITING VERIFIED RESULTS</small></div>
<div class="mainResult" id="mainResult"><div class="mainLabel" id="mainLabel">RESULT PENDING</div><div class="mainCopy"><div class="mainName" id="mainName">MAIN EVENT</div><div class="mainDetail" id="mainDetail">Official result pending</div><div class="mainDesc" id="mainDesc">WarGames results appear only after official verification.</div></div><div class="mainPhoto" id="mainPhoto"></div><div class="mainBelt" id="mainBelt"></div></div>
<div class="resultsHeading"><h2>OTHER MATCH RESULTS</h2><small id="otherStatus">RESULTS AS CONFIRMED</small></div><div class="additional" id="additional"><div class="otherCopy"><div class="otherLabel" id="otherLabel">AWAITING OFFICIAL RESULTS</div><div class="otherName" id="otherName">MATCH RESULTS</div><div class="otherDetail" id="otherDetail">Verified outcomes only</div><div class="otherDesc" id="otherDesc">Matches rotate as results are confirmed.</div></div><div class="otherPhotos" id="otherPhotos"></div><div class="otherBelt" id="otherBelt"></div></div>
<div class="falloutHeading"><h2>FALLOUT &amp; STORYLINES</h2><small id="falloutStatus">AFTER THE EVENT</small></div><div class="fallout"><h3 id="falloutTitle">THE AFTERMATH</h3><p id="falloutBody">Verified championship and storyline developments will appear here.</p></div><div class="venue" id="venue">DATE & LOCATION TO BE CONFIRMED</div></div></section>
<div class="reviewNotice" id="reviewNotice">VISUAL REVIEW ONLY · LIVE RESULTS NOT CONNECTED</div><footer class="ticker"><div class="tickerLogo"><img src="assets/user-survivor-series-wargames-houston-logo.png" alt="User-provided Survivor Series WarGames Houston logo"></div><div class="tickerTrack"><span id="tickerText">SURVIVOR SERIES: WARGAMES ◆ RESULTS &amp; FALLOUT ◆ VERIFIED WINNERS ◆ CHAMPIONSHIP DEVELOPMENTS ◆ SURVIVOR SERIES: WARGAMES ◆ RESULTS &amp; FALLOUT ◆ VERIFIED WINNERS ◆ CHAMPIONSHIP DEVELOPMENTS ◆</span></div></footer>
</main>
<script>
(()=>{'use strict';
const board=document.getElementById('board');
const $=id=>document.getElementById(id);
function fit(){board.style.transform='scale('+Math.min(innerWidth/720,innerHeight/1280)+')'}
window.addEventListener('resize',fit);fit();
const qs=new URLSearchParams(location.search),demo=qs.get('demo')==='1';let otherIndex=0,storyIndex=0;
const PORTRAITS=new Set(["austin-theory.png", "b-fab.png", "brad-baylor.png", "bron-breakker.png", "chad-gable.png", "chelsea-green.png", "grayson-waller.png", "indi-hartwell.png", "jackson-drake.png", "kelani-jordan.png", "liv-morgan.png", "michin.png", "raquel-rodriguez.png", "ricky-smokes.png", "roman-reigns.png", "sami-zayn.png", "trick-williams.png", "zaria.png"]),BELTS=new Set(["nxt_championship-transparent.png", "nxt_north_american-transparent.png", "nxt_tag_team-transparent.png", "nxt_womens_championship-transparent.png", "nxt_womens_north_american-transparent.png", "wwe_intercontinental-championship-transparent.png", "wwe_undisputed-wwe-championship-transparent.png", "wwe_united-states-championship-transparent.png", "wwe_womens-intercontinental-championship-transparent.png", "wwe_womens-united-states-championship-transparent.png", "wwe_womens-world-championship-transparent.png", "wwe_world-heavyweight-championship-transparent.png", "wwe_world-tag-team-championship-transparent.png", "wwe_wwe-tag-team-championship-transparent.png", "wwe_wwe-womens-championship-transparent.png", "wwe_wwe-womens-tag-team-championship-transparent.png"]);
const nameToFile=n=>String(n||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/['’]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')+'.png';
const picKey=person=>{const f=person?.portrait&&PORTRAITS.has(person.portrait)?person.portrait:nameToFile(person?.name);return PORTRAITS.has(f)?'assets/approved-portraits/'+f:null};
const beltKey=b=>typeof b==='string'&&BELTS.has(b)?'assets/approved-belts/'+b:null;
const sample={event_date:null,venue:null,main_event:{outcome:'decisive',kind:'wargames',type:'SAMPLE — 5-ON-5 WARGAMES MATCH',winner:{name:'TEAM RED',members:[{name:'Roman Reigns'},{name:'Sami Zayn'},{name:'Bron Breakker'},{name:'Chad Gable'},{name:'Trick Williams'}]},loser:'TEAM BLUE',description:'DESIGN DEMONSTRATION · NOT A REAL RESULT'},results:[{outcome:'decisive',kind:'singles',type:'SAMPLE WOMEN’S CHAMPIONSHIP RESULT',winner:{name:'Liv Morgan'},loser:'Chelsea Green',title:{name:'Women’s World Championship',belt:'wwe_womens-world-championship-transparent.png'},description:'SAMPLE OUTCOME · NOT ACTUAL'},{outcome:'decisive',kind:'tag',type:'SAMPLE TAG TEAM RESULT',winner:{name:'SAMI ZAYN & AUSTIN THEORY',members:[{name:'Sami Zayn'},{name:'Austin Theory'}]},loser:'TRICK WILLIAMS & CHAD GABLE',description:'SAMPLE TEAM RESULT · NOT ACTUAL'}],fallout:[{headline:'SAMPLE — SURVIVOR SERIES WARGAMES AFTERMATH',summary:'Illustrative storyline copy only. Official post-event developments replace this when verified.'}]};
sample.featured_results=[sample.main_event,{outcome:'decisive',kind:'wargames',type:'SAMPLE — WOMEN’S 5-ON-5 WARGAMES MATCH',winner:{name:'TEAM GOLD',members:[{name:'Liv Morgan'},{name:'Chelsea Green'},{name:'Raquel Rodriguez'},{name:'Zaria'},{name:'Michin'}]},loser:'TEAM SILVER',description:'DESIGN DEMONSTRATION · NOT A REAL RESULT'}];
const blank={event_date:null,venue:null,main_event:null,featured_results:[],results:[],fallout:[]};
let state=demo?sample:blank;let featureIndex=0;
const e=(tag,cl,text)=>{const n=document.createElement(tag);if(cl)n.className=cl;if(text!==undefined)n.textContent=String(text);return n};
const sourceOK=s=>{try{let u=new URL(s);return u.protocol==='https:'&&(u.hostname==='wwe.com'||u.hostname.endsWith('.wwe.com'))}catch{return false}};
const dateOK=s=>typeof s==='string'&&/^\d{4}-\d\d-\d\d$/.test(s)&&!Number.isNaN(Date.parse(s+'T12:00:00Z'));
const easternToday=()=>{const p=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const a=Object.fromEntries(p.map(v=>[v.type,v.value]));return a.year+'-'+a.month+'-'+a.day};
function validMatch(r,eventDate,now){
 if(!r||r.verified!==true||!sourceOK(r.source_url)||!dateOK(r.source_date)||r.source_date<eventDate||r.source_date>now||!['decisive','draw','no-contest'].includes(r.outcome))return false;
 if(typeof r.type!=='string'||r.type.length<3||r.type.length>140)return false;
 if(r.outcome==='decisive'){
  if(typeof r.winner?.name!=='string'||r.winner.name.length<2||r.winner.name.length>110||typeof r.loser!=='string'||!r.loser||r.loser.length>160)return false;
  if(r.winner.members!==undefined&&(!Array.isArray(r.winner.members)||r.winner.members.length<2||r.winner.members.length>6||!r.winner.members.every(m=>typeof m?.name==='string'&&m.name.length>1&&m.name.length<=85)))return false;
  if(r.kind==='wargames'&&(!Array.isArray(r.winner.members)||r.winner.members.length<4||r.winner.members.length>5))return false;
 }else if(!Array.isArray(r.participants)||r.participants.length<2||r.participants.length>20||!r.participants.every(m=>typeof m?.name==='string'&&m.name.length>0&&m.name.length<110))return false;
 if(r.title&&typeof r.title.name!=='string')return false;
 return true;
}
function validStory(r,eventDate,now){return !!(r&&r.verified===true&&sourceOK(r.source_url)&&dateOK(r.source_date)&&r.source_date>=eventDate&&r.source_date<=now&&typeof r.headline==='string'&&r.headline.length>2&&r.headline.length<160&&typeof r.summary==='string'&&r.summary.length>2&&r.summary.length<360)}
function validate(payload){
 if(!payload||payload.schema_version!==1||payload.event_id!=='survivor-series'||(payload.event_date!==null&&!dateOK(payload.event_date)))return null;
 const today=easternToday(),held=!!payload.event_date&&payload.event_date<=today;
 const featured=held&&Array.isArray(payload.featured_results)?payload.featured_results.filter(x=>validMatch(x,payload.event_date,today)&&x.kind==='wargames').slice(0,3):[];
 const legacy=held&&validMatch(payload.main_event,payload.event_date,today)?payload.main_event:null;
 return {event_date:payload.event_date,venue:typeof payload.venue==='string'&&payload.venue.length<140?payload.venue:null,main_event:featured[0]||legacy,featured_results:featured.length?featured:(legacy?[legacy]:[]),
 results:held&&Array.isArray(payload.results)?payload.results.filter(x=>validMatch(x,payload.event_date,today)).slice(0,30):[],fallout:held&&Array.isArray(payload.fallout)?payload.fallout.filter(x=>validStory(x,payload.event_date,today)).slice(0,25):[]};
}
function imgFor(person){const path=picKey(person);if(!path)return null;let i=e('img');i.src=path;i.alt=person.name;i.onerror=()=>{i.remove()};return i;}
function photos(holder,people,asTiles){holder.replaceChildren();holder.className=holder.id==='mainPhoto'?'mainPhoto':'otherPhotos';if(asTiles){for(const m of people.slice(0,5)){let t=e('div','tile');let pic=imgFor(m);if(pic)t.append(pic);else t.append(e('div','fallback','PORTRAIT PENDING'));t.append(e('span','',m.name));holder.append(t)}return}
 let success=0;for(const m of people.slice(0,2)){let i=imgFor(m);if(i){holder.append(i);success++}}if(success>1)holder.classList.add('two');if(!success)holder.append(e('div','fallback','PORTRAIT PENDING'));
}
function renderMatch(r,main){let prefix=main?'main':'other',el=x=>$(prefix+x),root=$(main?'mainResult':'additional');let photo=$(main?'mainPhoto':'otherPhotos'),belt=el('Belt');root.classList.remove('wargames','titleResult','multi');belt.replaceChildren();
 if(!r){el('Label').textContent=main?'WARGAMES · RESULT PENDING':'AWAITING VERIFIED RESULTS';el('Name').textContent=main?'MAIN EVENT':'MATCH RESULTS';el('Detail').textContent='OFFICIAL RESULTS PENDING';el('Desc').textContent=main?'Results appear after verification.':'Additional verified results rotate here.';photos(photo,[],false);return}
 el('Label').textContent=r.type.toUpperCase();el('Desc').textContent=r.description||'';let ppl=[];
 if(r.outcome==='decisive'){
  el('Name').textContent=r.winner.name.toUpperCase();el('Detail').textContent='def. '+r.loser;
  ppl=Array.isArray(r.winner.members)?r.winner.members:[r.winner];
  if(main&&r.kind==='wargames'&&ppl.length>=4){root.classList.add('wargames');photos(photo,ppl,true)}else photos(photo,ppl,false);
 }else{el('Name').textContent=r.outcome==='draw'?'MATCH ENDS IN A DRAW':'NO CONTEST';el('Detail').textContent=r.participants.map(x=>x.name).join(' · ');ppl=r.participants;photos(photo,ppl,false)}
 el('Name').className=(main?'mainName':'otherName')+(el('Name').textContent.length>(main?20:23)?' long':'');
 if(r.title&&!root.classList.contains('wargames')){let path=beltKey(r.title.belt);if(path){let im=e('img');im.src=path;im.alt=r.title.name+' belt';im.onerror=()=>im.remove();belt.append(im);root.classList.add('titleResult')}}
}
function renderOthers(){let rows=state.results||[];renderMatch(rows.length?rows[otherIndex%rows.length]:null,false);$('otherStatus').textContent=rows.length?'RESULT '+(otherIndex%rows.length+1)+' / '+rows.length:'RESULTS AS CONFIRMED'}
function renderStories(){let rows=state.fallout||[],item=rows.length?rows[storyIndex%rows.length]:null;$('falloutStatus').textContent=rows.length?'STORY '+(storyIndex%rows.length+1)+' / '+rows.length:'AFTER THE EVENT';$('falloutTitle').textContent=item?item.headline:'THE AFTERMATH';$('falloutBody').textContent=item?item.summary:'Verified championship developments, WarGames consequences and rivalries will appear here.'}
function renderFeatured(){const features=state.featured_results||[];const f=features.length?features[featureIndex%features.length]:state.main_event;
 $('mainStatus').textContent=f?(demo?'SAMPLE '+(featureIndex%features.length+1)+' / '+features.length:'RESULT '+(featureIndex%features.length+1)+' / '+features.length):'AWAITING VERIFIED RESULTS';
 renderMatch(f,true);
}
function render(){$('nightTop').textContent='WARGAMES';$('mainHeading').textContent='WARGAMES · FEATURED RESULTS';$('dateBar').textContent='SURVIVOR SERIES · '+(state.event_date||'DATE TO BE ANNOUNCED');$('venue').textContent=(state.venue||'DATE & LOCATION TO BE CONFIRMED').toUpperCase();renderFeatured();renderOthers();renderStories()}
if(demo){board.classList.add('demo');$('reviewNotice').textContent='DESIGN DEMONSTRATION · NOT ACTUAL MATCH RESULTS';$('tickerText').textContent='SAMPLE WARGAMES RESULTS ◆ ILLUSTRATIVE MATCHUPS ONLY ◆ NOT AN ACTUAL EVENT RESULT ◆ SAMPLE WARGAMES RESULTS ◆ '}
async function refresh(){if(demo||location.protocol==='file:')return;try{const r=await fetch('survivor-series-results-data.json?ts='+Date.now(),{cache:'no-store'});if(!r.ok)return;const d=validate(await r.json());if(!d)return;state=d;featureIndex=0;otherIndex=0;storyIndex=0;render()}catch{/* safe pending / retain last valid */}}
render();refresh();if(!qs.has('static')){setInterval(()=>{featureIndex++;renderFeatured()},15000);setInterval(()=>{otherIndex++;renderOthers()},10000);setInterval(()=>{storyIndex++;renderStories()},12000)}setInterval(refresh,300000);
window.__survivorResultsQA={state:()=>({demo,main:!!state.main_event,featured:state.featured_results?.length||0,featuredIndex:featureIndex%(state.featured_results?.length||1),other:state.results.length,fallout:state.fallout.length,wargames:!!state.main_event&&state.main_event.kind==='wargames'}),validate,setData:d=>{let v=validate(d);if(v){state=v;featureIndex=0;render();return true}return false},nextFeature:()=>{featureIndex++;renderFeatured()},nextResult:()=>{otherIndex++;renderOthers()},nextStory:()=>{storyIndex++;renderStories()}};
})();
</script></body></html>