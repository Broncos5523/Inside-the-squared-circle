<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#090e18"><title>Inside the Squared Circle — SummerSlam Upcoming Match Card · Local V2 Review</title><style>
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#020308;color:white}body{font-family:Arial,Helvetica,sans-serif;display:grid;place-items:center}#board{position:relative;width:720px;height:1280px;overflow:hidden;isolation:isolate;transform-origin:center;background:#071017}
.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.shroud{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,#02101acc 0%,#020d1de3 19%,#09101df7 43%,#06090efb 93%,#070507f7 100%)}.glow{position:absolute;z-index:1;border-radius:50%;filter:blur(40px);pointer-events:none}.glow.sun{width:420px;height:420px;left:-210px;top:165px;background:#ef5b1e;opacity:.11}.glow.blue{width:400px;height:350px;right:-230px;top:190px;background:#1987fa;opacity:.16}
