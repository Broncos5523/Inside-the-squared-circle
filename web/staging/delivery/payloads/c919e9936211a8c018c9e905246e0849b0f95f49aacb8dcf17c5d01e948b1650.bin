.belt-area{position:absolute;top:39px;left:231px;width:177px;height:83px;z-index:9;display:flex;align-items:center;justify-content:center}.belt-area img{max-height:74px;max-width:157px;object-fit:contain;filter:brightness(1.18) drop-shadow(0 0 7px #eca45655) drop-shadow(0 3px 6px black)}.belt-area .belt-pending{font-size:11px;text-align:center;color:#eeae87}
.duel{position:absolute;left:9px;right:9px;top:105px;bottom:14px;display:grid;grid-template-columns:minmax(0,1fr) 100px minmax(0,1fr);column-gap:4px}.fighter{border:1px solid #4b6a81;position:relative;background:radial-gradient(ellipse at 40% 40%,#38628a45,#060a128a 80%);min-width:0;overflow:hidden}.fighter.right{background:radial-gradient(ellipse at 60% 40%,#d3693345,#0b0b138c 85%)}.fighter .portrait-list{position:absolute;inset:7px 4px 40px;display:flex;align-items:end;justify-content:center;gap:0}.fighter .portrait-list img{height:100%;max-height:193px;max-width:100%;min-width:0;flex:1;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 3px 4px #000)}.fighter .portrait-list.multi img{max-height:178px;margin:0 -4px}.fighter .name{position:absolute;z-index:5;bottom:0;left:0;right:0;min-height:43px;display:flex;justify-content:center;align-items:center;padding:4px;font:900 17px/1.05 Impact,'Arial Black',sans-serif;letter-spacing:.3px;text-align:center;text-transform:uppercase;color:#f8fafc;background:linear-gradient(0deg,#050911 0%,#071629f7 83%,transparent)}.fighter.right .name{background:linear-gradient(0deg,#10080b,#1d1421ef 83%,transparent)}.fighter.empty .silhouette{position:absolute;top:45px;left:29%;width:42%;height:148px;background:radial-gradient(ellipse at 50% 16%,#4d617d 0 20%,transparent 21%),linear-gradient(#58657b,#29374c);clip-path:polygon(29% 0,71% 0,71% 28%,93% 48%,96% 100%,4% 100%,7% 48%,29% 28%);opacity:.31}
.duel-center{position:relative;display:flex;align-items:center;justify-content:center}.duel-center b{display:block;font:900 48px/1 Impact,'Arial Black',sans-serif;color:#fff0c0;letter-spacing:1px;text-shadow:1px 3px #481b20,0 0 14px #dd5a2a}.duel-center:before,.duel-center:after{content:'';position:absolute;left:48px;width:2px;height:63px;background:linear-gradient(transparent,#ad5e3b,transparent)}.duel-center:before{top:6px}.duel-center:after{bottom:2px}
.otherbar{height:37px;display:flex;align-items:center;justify-content:space-between;padding:0 4px;margin-top:6px}.otherbar h2{font:900 23px Impact,'Arial Black',sans-serif;letter-spacing:1px;margin:0;color:#ffdfad}.otherbar small{font-size:10px;color:#ffbb7c;font-weight:900;letter-spacing:1px}
.support{height:172px;border:1px solid #bc7652;border-left:4px solid #ffc170;background:linear-gradient(105deg,#18283b,#101626 50%,#3c1f1c);padding:8px;overflow:hidden;position:relative}.support-label{font-size:12px;font-weight:900;letter-spacing:.6px;color:#ffc689;text-align:center;margin:0 0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.support-row{height:125px;display:grid;grid-template-columns:1fr 74px 1fr;gap:5px}.support-side{display:flex;align-items:flex-end;justify-content:center;flex-direction:column;position:relative;overflow:hidden;background:#0b162466;border:1px solid #3c5060}.support-side:last-child{background:#23152355}.support-portraits{position:absolute;left:0;right:0;top:0;bottom:29px;display:flex;align-items:end;justify-content:center;overflow:hidden}.support-portraits img{height:100%;max-height:104px;min-width:0;max-width:100%;flex:1;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 3px 3px #000)}.support-side span{position:absolute;bottom:0;left:0;right:0;z-index:2;min-height:31px;background:linear-gradient(transparent,#071019 18%);text-align:center;display:flex;align-items:flex-end;justify-content:center;padding:2px 3px 4px;font-size:12px;line-height:1.08;font-weight:900;text-transform:uppercase;text-shadow:0 2px #000}.support-mid{position:relative;display:flex;align-items:center;justify-content:center}.support-mid b{font:900 29px Impact,'Arial Black',sans-serif;color:#fff2da}.support-mid img{position:absolute;top:0;width:72px;max-height:50px;object-fit:contain}.support-mid:has(img) b{padding-top:38px;font-size:27px}.support-pending{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;color:#fff0d7;gap:12px}.support-pending b{font:900 23px Impact,'Arial Black',sans-serif;letter-spacing:1px}.support-pending span{font-size:12px;color:#ffc08b}
.location{height:32px;margin-top:8px;display:flex;align-items:center;justify-content:center;border:1px solid #c07d4a;background:linear-gradient(90deg,#244967,#b14e29,#244b6e);font-size:11px;letter-spacing:1px;font-weight:900;color:#ffedc8}.safetynote{position:absolute;z-index:9;bottom:77px;left:0;right:0;text-align:center;color:#f0b885;font-size:10px;font-weight:900;letter-spacing:1px}
.ticker{position:absolute;z-index:10;bottom:0;left:0;right:0;height:66px;border-top:2px solid #d48b5d;background:#07080e;display:flex;overflow:hidden}.tickerbrand{flex:0 0 176px;display:grid;place-items:center;background:linear-gradient(90deg,#152d43,#76331e);border-right:2px solid #d98d58;padding:4px 8px}.tickerbrand img{max-height:60px;max-width:162px;object-fit:contain;filter:drop-shadow(0 1px 2px #000)}.tickertrack{white-space:nowrap;overflow:hidden;flex:1;display:flex;align-items:center;font-size:15px;font-weight:900;letter-spacing:.7px;color:#ffe7c4}.tickertrack div{display:inline-block;min-width:200%;animation:marquee 27s linear infinite;will-change:transform}@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
