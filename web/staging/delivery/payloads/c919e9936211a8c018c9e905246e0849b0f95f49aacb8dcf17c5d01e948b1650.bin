 {key:'night-one',label:'NIGHT ONE · EXAMPLE',main_event:{label:'SAMPLE WORLD HEAVYWEIGHT CHAMPIONSHIP MATCH',sides:[[{name:'Roman Reigns'}],[{name:'Sami Zayn'}]],belt_key:'wwe_world-heavyweight-championship-transparent.png',title:'WORLD HEAVYWEIGHT CHAMPIONSHIP'},other_matches:[{label:'SAMPLE WOMEN’S CHAMPIONSHIP MATCH',sides:[[{name:'Liv Morgan'}],[{name:'Chelsea Green'}]],belt_key:'wwe_wwe-womens-championship-transparent.png',title:'WWE WOMEN’S CHAMPIONSHIP'},{label:'SAMPLE NON-TITLE MATCH',sides:[[{name:'Chad Gable'}],[{name:'Trick Williams'}]],belt_key:null,title:null}]},
