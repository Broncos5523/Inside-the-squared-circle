const nameOK=n=>typeof n==='string'&&n.trim().length>0&&n.length<=65;const sideOK=s=>Array.isArray(s)&&s.length>=1&&s.length<=3&&s.every(x=>x&&nameOK(x.name));
const matchOK=x=>x&&x.verified===true&&sourceOK(x.source_url)&&d8(x.source_date)&&Array.isArray(x.sides)&&x.sides.length===2&&x.sides.every(sideOK)&&typeof x.label==='string'&&x.label.length<=105&&(!x.belt_key||BELTS.has(x.belt_key));
function verifiedCards(j){if(!j||j.schema_version!==1||j.event_id!=='summerslam'||!Array.isArray(j.cards))return null;const cards=j.cards.slice(0,3).map(c=>({label:typeof c?.label==='string'&&c.label.length<=35?c.label:'EVENT MATCH CARD',main_event:matchOK(c.main_event)?c.main_event:null,other_matches:Array.isArray(c.other_matches)?c.other_matches.filter(matchOK).slice(0,24):[]}));return {date:j.event_date_verified===true&&d8(j.event_date)?j.event_date:null,venue:j.venue_verified===true&&typeof j.venue==='string'&&j.venue.length<=150?j.venue:null,cards:cards.filter(c=>c.main_event||c.other_matches.length>0)}}
const E=(tag,cls,txt)=>{let n=document.createElement(tag);if(cls)n.className=cls;if(txt!=null)n.textContent=String(txt);return n};function clear(el){el.replaceChildren()}
function renderFighter(id,players){const el=$(id);clear(el);const group=Array.isArray(players)?players:[];if(!group.length){el.classList.add('empty');el.append(E('div','silhouette'));el.append(E('div','name','AWAITING ANNOUNCEMENT'));return}el.classList.remove('empty');let pr=E('div','portrait-list'+(group.length>1?' multi':''));for(const p of group){const src=portrait(p.name);if(src){let im=E('img');im.src=src;im.alt=p.name;im.onerror=()=>{im.remove()};pr.append(im)}}el.append(pr);el.append(E('div','name',group.map(p=>p.name).join(' & ')))}
function renderMain(m){const active=!!m;$('mainCaption').textContent=active?(m.label||'ANNOUNCED MAIN EVENT'):'MAIN EVENT ANNOUNCEMENT PENDING';$('mainStatus').textContent=demo?'VISUAL DEMONSTRATION':active?'SOURCE VERIFIED':'AWAITING OFFICIAL ANNOUNCEMENT';let wrap=$('mainBelt');clear(wrap);if(active&&m.belt_key&&belt(m.belt_key)){let im=E('img');im.src=belt(m.belt_key);im.alt=m.title||'Championship belt artwork';wrap.append(im)}else if(active&&m.title)wrap.append(E('div','belt-pending',m.title));renderFighter('mainLeft',active?m.sides[0]:[]);renderFighter('mainRight',active?m.sides[1]:[])}
function renderSupport(m,index,total){let p=$('supportMatch');clear(p);if(!m){let box=E('div','support-pending');box.append(E('b','','ANNOUNCEMENTS PENDING'));box.append(E('span','','Confirmed supporting matches will rotate here.'));p.append(box);$('otherStatus').textContent='AS CONFIRMED';return}let lab=E('div','support-label',m.label||'ANNOUNCED MATCH');p.append(lab);let row=E('div','support-row');for(let i=0;i<2;i++){if(i===1){let middle=E('div','support-mid');if(m.belt_key&&belt(m.belt_key)){let im=E('img');im.src=belt(m.belt_key);im.alt=m.title||'Championship belt';middle.append(im)}middle.append(E('b','','VS'));row.append(middle)}let side=E('div','support-side');const names=m.sides[i].map(x=>x.name);let strip=E('div','support-portraits');for(const n of names){const src=portrait(n);if(src){let im=E('img');im.src=src;im.alt=n;im.onerror=()=>im.remove();strip.append(im)}}side.append(strip);side.append(E('span','',names.join(' & ')));row.append(side)}p.append(row);$('otherStatus').textContent=(index+1)+' / '+total}
function render(){const cards=state.cards,c=cards.length?cards[currentCard%cards.length]:null;const ms=c?.other_matches||[];renderMain(c?.main_event||null);renderSupport(ms.length?ms[currentOther%ms.length]:null,ms.length?currentOther%ms.length:0,ms.length);$('nightLabel').textContent=c?.label||'EVENT MATCH CARD';$('eventDate').textContent='SUMMERSLAM · '+(state.date||'DATE TO BE ANNOUNCED');$('location').textContent=(state.venue||'DATE & LOCATION TO BE CONFIRMED').toUpperCase();$('safetynote').textContent=demo?'DEMONSTRATION ONLY · MATCHUPS ARE NOT REAL ANNOUNCEMENTS':'DISPLAYING SOURCE-VERIFIED MATCH ANNOUNCEMENTS ONLY';const msg=demo?'SUMMERSLAM • DESIGN DEMONSTRATION • SAMPLE MATCHUPS ONLY':'SUMMERSLAM • UPCOMING MATCH CARD • OFFICIAL ANNOUNCEMENTS AS VERIFIED';$('tickertext').textContent=(msg+'   ◆   ').repeat(7)}
if(demo)state={date:null,venue:null,cards:DESIGNS};render();
async function refresh(){if(demo||location.protocol==='file:')return;try{const r=await fetch('summerslam-preview-data.json?t='+Date.now(),{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);const s=verifiedCards(await r.json());if(s){state=s;currentCard=0;currentOther=0;render()}}catch(e){/* retain last good source verified state; no invented fallback */}}
refresh();setInterval(refresh,300000);
if(!qs.has('static')){setInterval(()=>{currentOther++;render()},10000);setInterval(()=>{currentCard++;currentOther=0;render()},19000)}
if(qs.get('card')==='2'&&demo){currentCard=1;render()}
window.__summerPreviewQA={render,refresh,snapshot:()=>({demo,cards:state.cards.length,card:currentCard,other:currentOther,venue:state.venue})};
})();
</script></body></html>