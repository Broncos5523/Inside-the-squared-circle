.logo-frame{position:absolute;top:187px;left:165px;width:390px;height:147px;z-index:5;border:1px solid #d4a35099;box-shadow:0 0 22px #e0752b3d,inset 0 0 9px #080808;overflow:hidden;border-radius:6px;background:#0a1019}.logo-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;object-position:center}.logo-frame:after{content:'';position:absolute;inset:0;border:2px solid #01142abb;pointer-events:none}
.header{position:absolute;top:345px;left:82px;width:556px;height:73px;z-index:6;text-align:center;border-top:2px solid #ffc974;border-bottom:2px solid #ffc974;background:linear-gradient(90deg,transparent,#301a17df 12%,#17273bfa 50%,#351514dd 88%,transparent);padding-top:6px}.header h1{font:900 35px/1.08 Impact,'Arial Black',sans-serif;letter-spacing:1.9px;margin:0;color:#fff2dc;text-shadow:0 2px 0 #02060c,0 0 14px #f56e34a8}.header p{font:900 12px/1.25 Arial,sans-serif;letter-spacing:1.5px;color:#ffd29b;margin:7px 0 0}
.demobar{display:none;position:absolute;z-index:7;top:423px;left:138px;width:444px;height:19px;background:linear-gradient(90deg,#dc8537,#ffe2a3,#d07843);color:#291410;padding-top:3px;text-align:center;font-size:10px;font-weight:900;letter-spacing:1px}.demo .demobar{display:block}
.frame{position:absolute;z-index:7;top:449px;left:19px;right:19px;height:741px;padding:6px;background:linear-gradient(143deg,#ffdf90,#da7a39 4%,#14293d 13%,#171b32 90%,#de7544 97%,#ffdb8c);clip-path:polygon(0 16px,16px 0,calc(100% - 16px) 0,100% 16px,100% calc(100% - 16px),calc(100% - 16px) 100%,16px 100%,0 calc(100% - 16px))}.inner{height:100%;background:linear-gradient(155deg,#0d2034,#090e1a 48%,#16111a 100%);padding:8px 10px;clip-path:inherit}
.info{height:29px;background:linear-gradient(90deg,#9c371d,#253d54 36%,#131d2c 64%,#b45b28);border-left:3px solid #e8ad59;border-right:3px solid #e8ad59;color:#ffeac1;display:flex;align-items:center;justify-content:space-between;padding:0 8px;font-size:12px;font-weight:900;letter-spacing:1px}
.sectionbar{height:37px;display:flex;align-items:center;justify-content:space-between;padding:0 4px}.sectionbar h2{margin:0;font:900 24px Impact,'Arial Black',sans-serif;letter-spacing:1.1px;color:#fff0d5}.sectionbar small{font-size:10px;font-weight:900;letter-spacing:1px;color:#ffbe89}
.main-card{position:relative;height:362px;background:linear-gradient(120deg,#1b3147 0%,#08111e 47%,#35201e 100%);border:2px solid #de9e5d;box-shadow:inset 0 0 30px #02050bbd,0 0 10px #f1822b22;overflow:hidden}.main-card:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.28;background:linear-gradient(135deg,transparent 27%,#eda34d16 27% 29%,transparent 29% 58%,#357bc026 59%,transparent 60%)}
