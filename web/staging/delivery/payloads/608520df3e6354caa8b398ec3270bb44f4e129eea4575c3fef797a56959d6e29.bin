/* larger TV-broadcast champion names; single champions do not need a redundant sub-label */
.crown-rule span{font-size:54px}
.feat-name{top:106px;left:18px;right:16px;min-height:75px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:78px;line-height:1.05;letter-spacing:-1.8px}
.feat-name.long{font-size:64px}.feat-name.tag{font-size:77px}
.feat-members{bottom:8px;font-size:17px;letter-spacing:.3px}

/* AAA Lucha Libre inherited structural spacing: same Champions master, label and tag-member clearance only */
.feat-name.tag{top:101px;font-size:70px;min-height:73px}
.feat-members{bottom:5px;text-align:center}
.ticker-label{width:185px;font-size:25px;letter-spacing:-.6px}
.ticker-body{font-size:18px;margin-left:12px}
.cap-left{font-size:19px;letter-spacing:0}

/* AAA Champions base — consistent centered metallic master, TNA-approved warm arena identity */
:root{--red:#f3aa53;--redwhite:#fff1d5;--deep:#180703}
#stage{background:#160a08}
#stage:before{background:linear-gradient(180deg,#0c030030,#19050335 19%,transparent 43%,#26060275 64%,#160905c9 89%,#000 100%)}
#stage:after{box-shadow:inset 0 0 0 2px #b9612880,inset 0 0 38px #120200}
.aaa-show-brand{position:absolute;left:242px;top:235px;width:236px;height:104px;z-index:11;object-fit:contain;filter:drop-shadow(0 4px 6px #000b) drop-shadow(0 0 9px #dd761b70)}
.crown-rule{top:342px}.crown-rule:before,.crown-rule:after{background:linear-gradient(90deg,transparent,#c8402b 30%,#ffd27f);box-shadow:0 0 8px #d3440f}
.crown-rule span{color:#faf4ea!important;-webkit-text-fill-color:#faf4ea!important;-webkit-text-stroke:1px #ac875a!important;text-shadow:0 1px #fff7db,0 3px #a28353,0 5px #40210e,0 8px 8px #000,0 0 10px #c7511e}
.portrait-stage{top:400px}
.champ-panel{background:linear-gradient(140deg,#ffe7ae 0,#c77632 2.5%,#693418 5%,#220c0b 10%,#130705 88%,#b75a28 98%,#ffebb7)}
.champ-panel:before{background:linear-gradient(135deg,#2a0c08,#140b0a 55%,#3b160e)}
.cap-row{border-bottom:1px solid #bb8b4090}
.cap-left{color:#fff3dd!important;-webkit-text-fill-color:#fff3dd!important;-webkit-text-stroke:.6px #b99659!important;text-shadow:0 1px #fff9e5,0 2px #695439,0 4px #20150d,0 6px #000;font-size:21px}
.cap-left:before{color:#f7b341}
.cap-right{color:#f7dca6}
.feature{background:repeating-linear-gradient(139deg,transparent 0 3px,#db622307 3px 5px),radial-gradient(ellipse at 75% 0%,#b9622523,transparent 70%),linear-gradient(110deg,#260e0b,#110b0a 80%);border:2px solid #98602e;border-top:2px solid #edb65e;box-shadow:inset 0 0 15px #aa541b20,0 0 7px #cc6c2c30}
.feat-label{color:#ffdba1!important;-webkit-text-fill-color:#ffdba1!important;-webkit-text-stroke:.5px #b38144!important;text-shadow:0 1px #fff2cf,0 2px #93663e,0 3px #301708,0 5px 5px #000}
.feat-rule{background:linear-gradient(90deg,#a64420,#ffe1a2 50%,#b5642d);box-shadow:0 0 8px #ad461d}
.feat-name{color:#f3f2ef!important;-webkit-text-fill-color:#f3f2ef!important;-webkit-text-stroke:1px #9295a0!important;text-shadow:0 1px #fff,0 2px #a3a3a9,0 3px #62636b,0 4px #353033,0 5px #682809,0 7px #180b05,0 10px 9px #000,0 0 16px #d27a3290}
.feat-members{color:#f8dda9;text-align:center}
.bottom-note{background:linear-gradient(90deg,#74421d 0%,#8e5126 8%,#281a17 49%,#462017 95%);border:1px solid #9d5d30;border-left:4px solid #f5cb85}
.ticker{border-top:3px solid #e4a14a;background:linear-gradient(90deg,#43170d,#8e3a1c 28%,#1d0805 90%)}
.ticker-label{width:124px;font-size:39px;background:linear-gradient(130deg,#ae541b,#421609);border-right:2px solid #ffe0a1}
.ticker-body{font-size:17px;color:#fbe2b9}
/* The group artwork is already a professionally prepared combined portrait. */
.portraits.tag img:only-child{width:650px;height:535px;margin:0;transform:none;object-fit:contain}
.feat-name.tag{font-size:74px;min-height:73px}
.feat-name.long{font-size:66px}
.feat-name{justify-content:center;text-align:center}
.feat-members{bottom:5px}

/* AAA Lucha Libre Champions: approved centered metallic typography, unique green/red brand palette.
   The supplied source arena, logo, portraits and title belts are unchanged. */
:root{--red:#1ccb71;--deep:#071d12}
#stage{background:#03150c}
#stage:before{background:linear-gradient(180deg,#020a0344 0%,#07150a44 19%,#06180b00 32%,#001b0fa0 65%,#02110bd9 88%,#000 100%)}
#stage:after{box-shadow:inset 0 0 0 2px #53cd7299,inset 0 0 40px #041b0c}
.aaa-show-brand{position:absolute;left:245px;top:238px;width:230px;height:110px;z-index:11;object-fit:contain;filter:drop-shadow(0 4px 6px #000c) drop-shadow(0 0 12px #36d64e4d)}
.crown-rule{top:343px}
.crown-rule:before,.crown-rule:after{background:linear-gradient(90deg,transparent,#16ae59 34%,#f34b48 90%,#ffffff);box-shadow:0 0 9px #08ce65}
.crown-rule span{color:#fafafa!important;-webkit-text-fill-color:#fafafa!important;-webkit-text-stroke:.9px #c4d4ca!important;text-shadow:0 1px #fff,0 3px #a7b7ae,0 5px #27543b,0 8px 8px #000,0 0 10px #0edf68}
.champ-panel{background:linear-gradient(145deg,#e8ffe8 0,#1abb5b 2.5%,#104d32 5%,#081e13 10%,#100c0b 85%,#ba2525 98%,#f4d9c3)}
.champ-panel:before{background:linear-gradient(135deg,#08291a,#06180f 48%,#1a100e 82%,#270c08)}
.cap-row{border-bottom-color:#42d98d91}
.cap-left{color:#f7fff8!important;-webkit-text-fill-color:#f7fff8!important;-webkit-text-stroke:.4px #b5d7bd!important;font-size:20px;text-shadow:0 2px #799986,0 4px #0c2516,0 6px #000}
.cap-left:before{color:#62f9a0}
.cap-right{color:#f3f9ef}
.feature{background:repeating-linear-gradient(139deg,transparent 0 3px,#0aba5a0c 3px 5px),radial-gradient(ellipse at 75% 0%,#12b54a28,transparent 70%),linear-gradient(110deg,#092718,#0b1611 80%);border-color:#277546;border-top-color:#b0fac9;box-shadow:inset 0 0 17px #115d2b4f,0 0 8px #10d05a2b}
.feat-label{color:#ffe2a2!important;-webkit-text-fill-color:#ffe2a2!important;-webkit-text-stroke:.5px #b99c48!important;text-shadow:0 1px #ffebc1,0 2px #866d3b,0 3px #241407,0 5px 5px #000}
.feat-rule{background:linear-gradient(90deg,#1d9c4e,#f0f1e6 52%,#c63131);box-shadow:0 0 8px #04b851}
.feat-name{color:#f5f8f5!important;-webkit-text-fill-color:#f5f8f5!important;-webkit-text-stroke:.9px #c2ccc6!important;text-shadow:0 1px #fff,0 2px #b1b9b4,0 3px #7a837a,0 4px #353f3a,0 5px #134c2e,0 7px #051e0f,0 10px 9px #000,0 0 13px #16b76280}
.feat-members{color:#f8ecdb;text-align:center;bottom:4px;font-size:16px}
.bottom-note{background:linear-gradient(90deg,#0f6d3a 0%,#187f3e 8%,#071d14 49%,#75171a 95%);border:1px solid #33b46d;border-left:4px solid #bbf8cf}
.ticker{border-top:3px solid #42df7e;background:linear-gradient(90deg,#053a24,#166c3d 24%,#12120a 65%,#220a08 95%)}
.ticker-label{width:126px;font-size:42px;background:linear-gradient(130deg,#1c9e59,#0c4829);border-right:2px solid #f75b54}
.ticker-body{font-size:17px;color:#efffec}
.portrait-stage{top:401px}
.portraits.trios img{width:254px;height:525px;margin-left:-13px;margin-right:-13px}
.portraits.trios img:nth-child(2){height:547px;z-index:1}
.portraits.belt-feature img{width:545px;height:410px;align-self:center;object-fit:contain;filter:drop-shadow(0 10px 10px #000) drop-shadow(0 0 24px #31bd6399)}
.portraits.tag img:only-child{width:610px;height:528px;margin:0;transform:none}
.feat-name.tag{font-size:69px}
.feat-name.long{font-size:66px}
.feat-name{justify-content:center;text-align:center}
</style></head><body>
<main id="stage"><img id="arena" alt="Approved AAA Lucha Libre arena" src="assets/user-aaa-arena.png"><img class="brand" alt="Approved Man Cave Sports Book Presents Inside the Squared Circle" src="assets/user-mancave-master-logo-transparent.png"><img class="aaa-show-brand" src="assets/user-aaa-stage-logo-from-arena.png" alt="AAA Lucha Libre"/><div class="crown-rule"><span>CHAMPIONS</span></div><div class="portrait-stage"><div class="portraits" id="portraits"></div></div><div class="portrait-floor"></div><section class="champ-panel"><div class="cap-row"><div class="cap-left">AAA CHAMPIONSHIP SPOTLIGHT</div><div class="cap-right" id="page">01 / 07</div></div><div class="feature"><div class="feat-label" id="belt-title"></div><div class="belt-wrap"><img class="belt" id="belt" alt=""></div><div class="feat-rule"></div><div class="feat-name" id="name"></div><div class="feat-members" id="members"></div></div><div class="bottom-note"><small>DAYS AS CHAMPION</small><span id="since"></span></div><div class="tagline">WHEN THE BELL RINGS, IT GETS REAL.</div></section><footer class="ticker"><div class="ticker-label"><span>AAA</span></div><div class="ticker-body"><div class="ticker-text" id="ticker"></div></div></footer></main>
<script>
(() => {'use strict';
let CHAMPIONS=[{"id":"aaa-mega","title":"AAA MEGA CHAMPIONSHIP","name":"EL GRANDE AMERICANO","members":["El Grande Americano"],"portraits":["el-grande-americano.png"],"belt":"mega.png","since_date":"2026-09-13","kind":"singles","source":"https://www.wwe.com/shows/aaa/aaa-h-roes-inmortales-week-1-results"},{"id":"aaa-reina","title":"AAA REINA DE REINAS CHAMPIONSHIP","name":"LA CATALINA","members":["La Catalina"],"portraits":["la-catalina.png"],"belt":"reina_de_reinas.png","since_date":"2026-09-13","kind":"singles","source":"https://www.wwe.com/shows/aaa/aaa-h-roes-inmortales-week-1-results"},{"id":"aaa-latin","title":"AAA LATIN AMERICAN CHAMPIONSHIP","name":"LA PARKA","members":["La Parka"],"portraits":[],"belt":"latin_american.png","since_date":"2026-08-30","kind":"singles","source":"https://www.cagematch.net/?id=8&nr=122&page=9"},{"id":"aaa-cruiser","title":"AAA WORLD CRUISERWEIGHT CHAMPIONSHIP","name":"REY FENIX","members":["Rey Fenix"],"portraits":["rey-fenix.png"],"belt":"cruiserweight.png","since_date":"2026-05-30","kind":"singles","source":"https://www.wwe.com/shows/aaa/aaa-h-roes-inmortales-week-1-results"},{"id":"aaa-tag","title":"AAA WORLD TAG TEAM CHAMPIONSHIP","name":"THE WAGNER BROTHERS","members":["El Hijo de Dr. Wagner Jr.","Galeno"],"portraits":["galeno.png"],"belt":"world_tag.png","since_date":"2026-09-13","kind":"tag","source":"https://www.cagematch.net/?id=8&nr=122&page=9"},{"id":"aaa-trios","title":"AAA WORLD TRIOS CHAMPIONSHIP","name":"LOS PERROS DEL MAL","members":["Daga","Angel","Berto"],"portraits":["daga.png","angel.png","berto.png"],"belt":"world_trios.png","since_date":"2026-09-11","kind":"tag","source":"https://www.wwe.com/shows/aaa/aaa-h-roes-inmortales-week-1-results"},{"id":"aaa-mixed","title":"AAA WORLD MIXED TAG CHAMPIONSHIP","name":"LAREDO KID & LA HIEDRA","members":["Laredo Kid","La Hiedra"],"portraits":[],"belt":"mixed_tag.png","since_date":"2026-07-25","kind":"tag","source":"https://www.cagematch.net/?id=8&nr=122&page=9"}];
let AS_OF='2026-10-25';
const qs=new URLSearchParams(location.search);
let ix=Math.max(0,Math.min(CHAMPIONS.length-1,Number(qs.get('card')||1)-1));
const $=id=>document.getElementById(id);
function easternToday(){const p=Object.fromEntries(new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()).filter(p=>p.type!=='literal').map(p=>[p.type,Number(p.value)]));return Date.UTC(p.year,p.month-1,p.day);}
function daysAsChampion(dateString){if(!/^\d{4}-\d{2}-\d{2}$/.test(dateString||''))return '—';const [year,month,day]=dateString.split('-').map(Number);const start=Date.UTC(year,month-1,day);if(new Date(start).toISOString().slice(0,10)!==dateString)return '—';const delta=Math.floor((easternToday()-start)/86400000);return delta>=0?delta.toLocaleString('en-US')+' DAYS':'—';}
function snapshotExpired(){const end=Date.UTC(...AS_OF.split('-').map((v,i)=>Number(v)-(i===1?1:0)));return (easternToday()-end)/86400000>14;}
function updateReignClock(){const c=CHAMPIONS[ix];const text=snapshotExpired()?'—':daysAsChampion(c.since_date);if($('since').textContent!==text)$('since').textContent=text;}
function fitChampionName(){const el=$('name');el.style.fontSize='';let sz=parseFloat(getComputedStyle(el).fontSize);for(let n=0;n<20;n++){const range=document.createRange();range.selectNodeContents(el);if(range.getBoundingClientRect().width<=el.clientWidth-8)break;sz-=2;el.style.fontSize=sz+'px';}}
function render(){const c=CHAMPIONS[ix],expired=snapshotExpired();$('page').textContent=String(ix+1).padStart(2,'0')+' / '+String(CHAMPIONS.length).padStart(2,'0');$('belt-title').textContent=c.title;$('belt').src=expired||!c.belt?'':'assets/'+c.belt;$('belt').style.display=expired||!c.belt?'none':'block';$('belt').alt=c.title+' title belt';$('name').textContent=expired?'TITLEHOLDER UPDATE PENDING':c.name;$('name').className='feat-name'+(c.kind==='tag'?' tag':c.name.length>14?' long':'');$('members').textContent=expired?'':(c.kind==='tag'?c.members.join('  •  '):'');updateReignClock();fitChampionName();
const p=$('portraits');p.className='portraits'+(c.kind==='tag' && c.portraits.length>1?' tag':'')+(c.portraits.length===3?' trios':'')+(!c.portraits.length?' belt-feature':'');p.replaceChildren();if(!expired){if(c.portraits.length){c.portraits.forEach((a,i)=>{let img=document.createElement('img');img.src='assets/'+a;img.alt=c.members.length===c.portraits.length?c.members[i]:c.members[c.members.length-1];img.decoding='async';p.append(img)})}else if(c.belt){const img=document.createElement('img');img.src='assets/'+c.belt;img.alt=c.title+' approved championship belt artwork';img.decoding='async';p.append(img)}};
let t=expired?'CURRENT CHAMPIONSHIP DATA IS BEING UPDATED':CHAMPIONS.map(x=>x.title+'  ◆  '+x.name).join('      ◆      ');$('ticker').textContent=t+'      ◆      '+t;}
function fit(){const s=$('stage');const k=Math.min(innerWidth/720,innerHeight/1280);s.style.transform='scale('+k+')';s.style.margin=(-(1280*(1-k))/2)+'px '+(-(720*(1-k))/2)+'px';}
window.addEventListener('resize',fit,{passive:true});window.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){ix=(ix+1)%CHAMPIONS.length;render()}if(e.key==='ArrowLeft'){ix=(ix-1+CHAMPIONS.length)%CHAMPIONS.length;render()}});

// Read the local reviewed championship data when hosted. This is NOT a results collector;
// an upstream, source-verified snapshot writer must replace champions-data.json.
const verifiedImageName = x => typeof x === 'string' && /^[a-z0-9][a-z0-9-_]*\.png$/i.test(x);
function validChampions(d){
 if(!d || d.schema_version!==1 || d.show!=='aaa' || !/^\d{4}-\d{2}-\d{2}$/.test(d.as_of||'') || !Array.isArray(d.champions) || d.champions.length<1 || d.champions.length>12)return false;
 return d.champions.every(x=>x && typeof x.id==='string' && typeof x.name==='string' && typeof x.title==='string' &&
 Array.isArray(x.members) && Array.isArray(x.portraits) && x.portraits.length>=0 && x.portraits.length<=3 &&
 (x.portraits.length===0 || x.members.length===x.portraits.length || (x.kind==='tag' && x.portraits.length===1 && x.members.length===2)) && x.members.every(v=>typeof v==='string') &&
 x.portraits.every(verifiedImageName) && (x.belt===null || verifiedImageName(x.belt)) && /^\d{4}-\d{2}-\d{2}$/.test(x.since_date||'') &&
 (x.kind==='singles'||x.kind==='tag'));
}
async function refreshReviewedSnapshot(){
 // file:// mode works entirely from the embedded matching snapshot.
 if(location.protocol==='file:')return;
 try{
  const response=await fetch('./champions-data.json?t='+Math.floor(Date.now()/600000),{cache:'no-store'});
  if(!response.ok)throw Error('snapshot unavailable');
  const data=await response.json();if(!validChampions(data))throw Error('snapshot invalid');
  if(data.as_of<AS_OF)return; // never regress to an older checkpoint
  const latest=JSON.stringify(data.champions);
  if(data.as_of===AS_OF && latest===JSON.stringify(CHAMPIONS))return;
  AS_OF=data.as_of;CHAMPIONS=data.champions;ix%=CHAMPIONS.length;render();
 }catch(_err){ /* retain the last known good data; expiry guard still applies */ }
}
function preloadLocalGraphics(){
 const unique=[...new Set(CHAMPIONS.flatMap(c=>[...c.portraits,c.belt]).filter(Boolean))];
 unique.forEach(name=>{const im=new Image();im.decoding='async';im.src='assets/'+name;});
}
preloadLocalGraphics();
fit();render();refreshReviewedSnapshot();setInterval(refreshReviewedSnapshot,600000);setInterval(updateReignClock,60000);if(!qs.has('card')&&!qs.has('static'))setInterval(()=>{ix=(ix+1)%CHAMPIONS.length;render()},11000);
})();
</script></body></html>