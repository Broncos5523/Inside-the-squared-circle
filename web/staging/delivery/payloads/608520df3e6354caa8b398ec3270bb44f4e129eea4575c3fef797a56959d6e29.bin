<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#050d1c"><title>Man Cave Sports Book — AAA Lucha Libre Champions (local review)</title><style>
:root{color-scheme:dark;--red:#3473f3;--redwhite:#fff0f2;--deep:#040b18}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#030509}
body{display:grid;place-items:center;font-family:Arial,Helvetica,sans-serif}
#stage{position:relative;width:720px;height:1280px;flex:0 0 auto;transform-origin:50% 50%;overflow:hidden;background:#040810}
#arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
#stage:before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,#08000530 0%,#10000a45 20%,transparent 35%,#00081999 65%,#030811 88%,#000 100%)}
#stage:after{content:"";position:absolute;z-index:15;inset:0;pointer-events:none;box-shadow:inset 0 0 0 2px #2458c477,inset 0 0 38px #010817}
.brand{position:absolute;z-index:10;top:1px;left:0;width:720px;height:238px;object-fit:contain;object-position:top center;filter:drop-shadow(0 4px 9px #000)}
.show-logo{position:absolute;z-index:10;left:170px;top:237px;width:380px;height:132px;display:flex;align-items:center;justify-content:center;color:#296cf4;font-size:93px;font-family:Impact,'Arial Narrow',Arial,sans-serif;font-weight:1000;letter-spacing:2px;-webkit-text-stroke:2px #fcfcfc;text-shadow:0 8px 0 #001236,0 12px 13px #000,0 0 17px #347fff}
.crown-rule{position:absolute;top:368px;left:20px;right:20px;height:46px;z-index:7;display:flex;align-items:center;justify-content:center;gap:12px;color:#fff;font-weight:1000;font-size:31px;letter-spacing:6px;text-shadow:0 2px 3px #000,0 0 9px #1159ee}
.crown-rule:before,.crown-rule:after{content:"";display:block;height:3px;flex:1;background:linear-gradient(90deg,transparent,#3574f4);box-shadow:0 0 13px #0039ad}.crown-rule:after{transform:scaleX(-1)}
.portrait-stage{position:absolute;z-index:3;top:402px;height:539px;left:0;right:0;overflow:hidden;filter:drop-shadow(0 12px 11px #000b)}
.portrait-stage:before{content:"";position:absolute;inset:40px 36px 0;background:radial-gradient(ellipse at 50% 60%,#2c71ff24,transparent 64%);pointer-events:none}
.portraits{height:100%;width:100%;display:flex;align-items:flex-end;justify-content:center;gap:0}
.portraits img{width:620px;height:538px;object-fit:contain;object-position:bottom center;flex:0 0 auto;filter:drop-shadow(8px 7px 7px #000b)}
.portraits.tag img{width:360px;height:519px}.portraits.tag img:first-child{margin-right:-15px;transform:translateX(15px)}.portraits.tag img:last-child{margin-left:-15px;transform:translateX(-15px)}
.portrait-floor{position:absolute;z-index:4;left:0;right:0;top:807px;height:142px;background:linear-gradient(0deg,#030813 0%,#030813e8 25%,transparent 100%);pointer-events:none}
.champ-panel{position:absolute;z-index:8;top:862px;left:16px;width:688px;height:351px;overflow:hidden;clip-path:polygon(0 19px,21px 0,calc(100% - 20px) 0,100% 20px,100% calc(100% - 20px),calc(100% - 20px) 100%,20px 100%,0 calc(100% - 20px));background:linear-gradient(145deg,#fff 0,#346fe7 3%,#102d68 5%,#071126 11%,#050e21 80%,#1b4eb8 97%,#fff)}
.champ-panel:before{position:absolute;content:"";inset:5px;clip-path:inherit;background:linear-gradient(130deg,#091838,#0d0b0f 52%,#041331);z-index:0}
.cap-row{position:relative;z-index:2;height:53px;margin:10px 28px 0;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #689aff8c}
.cap-left{font-size:18px;font-weight:1000;letter-spacing:1.8px;color:#fff7f9;text-shadow:0 0 8px #3064ce}
.cap-left:before{content:'///';font-size:27px;font-style:italic;color:#75a2ff;margin-right:13px}
.cap-right{font-size:14px;font-weight:1000;letter-spacing:3px;color:#ffdce5}
.feature{position:relative;z-index:2;height:201px;margin:0 23px;border:1px solid #304f8f;border-top:2px solid #6998f7;background:radial-gradient(ellipse at 78% 24%,#2766e72e,transparent 70%),linear-gradient(110deg,#101d38,#0b0a10 77%)}
.feat-label{position:absolute;left:19px;top:10px;right:203px;font-size:19px;letter-spacing:2px;font-weight:1000;color:#c7d9ff;line-height:1.08;text-shadow:0 1px 2px #000}
.belt-wrap{position:absolute;right:12px;top:1px;width:196px;height:89px;display:flex;align-items:center;justify-content:center}
.belt{max-height:85px;max-width:190px;object-fit:contain;filter:drop-shadow(0 4px 3px #000b) drop-shadow(0 0 7px #608ff055)}
.feat-rule{position:absolute;left:19px;right:16px;top:91px;height:2px;background:linear-gradient(90deg,#3561bb,#d7e4ff 49%,#204081);box-shadow:0 0 7px #356fe5}
.feat-name{position:absolute;left:17px;right:12px;top:103px;font-family:Impact,'Arial Narrow',Arial,sans-serif;font-size:60px;font-weight:1000;letter-spacing:1px;line-height:1;color:#fff;text-transform:uppercase;text-shadow:0 3px 1px #123886,0 6px 10px #000}
.feat-name.long{font-size:51px}.feat-name.tag{font-size:58px}
.feat-members{position:absolute;left:20px;right:20px;bottom:13px;font-size:19px;letter-spacing:1.5px;font-weight:900;color:#cbdcff}
.bottom-note{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;margin:14px 28px 0;min-height:47px;padding:0 17px;background:linear-gradient(90deg,#2a57b2,#101c34 14%,#0e1421 89%,#224ca3);border-left:4px solid #ffe5ec;color:#fff;font-size:22px;font-weight:900;letter-spacing:.8px}
.bottom-note small{font-size:12px;letter-spacing:2px;color:#ffe0e7}
.tagline{position:relative;z-index:3;text-align:center;font-size:11px;letter-spacing:2.4px;color:#ffe6eb;font-weight:900;margin-top:7px}
.ticker{position:absolute;z-index:20;bottom:0;left:0;right:0;height:60px;display:flex;align-items:center;overflow:hidden;border-top:3px solid #689aff;box-shadow:0 -4px 13px #000d;background:linear-gradient(90deg,#07193e,#133374 25%,#030a17 90%)}
.ticker-label{height:100%;width:143px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;border-right:2px solid #76a0f7;font-size:36px;font-weight:1000;color:#fff;background:linear-gradient(130deg,#2859bc,#071636);transform:skewX(-9deg);margin-left:-8px;text-shadow:0 1px 3px #000}
.ticker-label span{transform:skewX(9deg)}
.ticker-body{min-width:0;overflow:hidden;flex:1;white-space:nowrap;margin-left:16px;color:#ffe3eb;font-size:19px;font-weight:900;letter-spacing:1px}
.ticker-text{display:inline-block;animation:ticker 30s linear infinite;white-space:nowrap}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.ticker-text{animation:none}}

/* CHAMPIONS BROADCAST TYPE TREATMENT v1 — CSS only; original user graphics untouched */
:root{--silver1:#fff;--silver2:#d7dce5;--silver3:#66717d;--gold1:#fff9ca;--gold2:#d8aa59;--gold3:#69502b}
.crown-rule{top:352px;height:72px;gap:15px;letter-spacing:.5px;z-index:11}
.crown-rule:before,.crown-rule:after{height:4px;background:linear-gradient(90deg,transparent,#3074ff 30%,#bdd3ff);box-shadow:0 0 11px #125ffe,0 1px 0 #b2cbff}
.crown-rule span{display:block;font-family:Impact,'Arial Narrow','Liberation Sans Narrow',sans-serif;font-stretch:condensed;font-size:51px;line-height:1.08;letter-spacing:1.5px;padding:0 7px;text-transform:uppercase;background:linear-gradient(180deg,#fff 0%,#d6dbe2 15%,#677181 43%,#fff 51%,#c1c6d3 62%,#515660 85%,#f4f7ff 100%);background-clip:text;-webkit-background-clip:text;color:transparent;-webkit-text-stroke:.65px #d6e0e5;filter:drop-shadow(0 2px 0 #001541) drop-shadow(0 5px 1px #06040a) drop-shadow(0 0 7px #1662fd)}
.champ-panel{top:859px;height:355px;box-shadow:0 0 24px #276eff7a;background:linear-gradient(142deg,#ffe2e9 0%,#2569f4 1.7%,#092661 3.5%,#030915 8%,#040810 86%,#2365ed 98%,#fff6f9)}
.champ-panel:before{background:linear-gradient(140deg,#040b1a,#100910 38%,#040e24 74%,#061739)}
.cap-row{height:56px;margin:8px 20px 0;border-bottom:1px solid #376bd680}
.cap-left{font-family:Impact,'Arial Narrow',sans-serif;font-style:italic;font-size:24px;font-weight:900;letter-spacing:.4px;white-space:nowrap;background:linear-gradient(180deg,#fff 2%,#c9cbd2 34%,#555b69 52%,#fff 72%,#aab0bd 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:.2px #dde4f0;filter:drop-shadow(1px 2px 1px #000)}
.cap-left:before{font-family:Arial,sans-serif;font-weight:1000;font-size:26px;color:#578eff;-webkit-text-stroke:0;filter:drop-shadow(0 0 5px #145ae8);margin-right:12px}
.cap-right{font-family:Impact,'Arial Narrow',sans-serif;font-style:italic;font-size:19px;letter-spacing:2px;color:#f9dce3;text-shadow:1px 2px #000,0 0 4px #6396ff}
.feature{height:205px;margin:0 18px;background:repeating-linear-gradient(139deg,transparent 0 3px,#1460fc08 3px 5px),radial-gradient(ellipse at 75% 0%,#2655b428,transparent 75%),linear-gradient(110deg,#040d20,#0b0a10 80%);border:2px solid #2259cb;border-top:2px solid #7ea8ff;box-shadow:inset 0 0 15px #0b43b540,0 0 7px #3376ff26}
.feat-label{top:10px;left:18px;right:180px;height:73px;display:flex;align-items:flex-start;font-family:Impact,'Arial Narrow',sans-serif;font-style:normal;font-size:25px;font-weight:900;letter-spacing:.45px;line-height:1.08;background:linear-gradient(180deg,#fff8d4 1%,#edcb86 27%,#926728 58%,#fff1b3 75%,#b38438 100%);background-clip:text;-webkit-background-clip:text;color:transparent;-webkit-text-stroke:.45px #e0c586;filter:drop-shadow(1px 3px 1px #000);text-transform:uppercase}
.belt-wrap{width:177px;height:87px;top:8px;right:9px}
.belt{max-width:173px;max-height:83px;filter:drop-shadow(0 3px 3px #000f) drop-shadow(0 0 7px #facf7992)}
.feat-rule{top:98px;left:16px;right:15px;height:3px;background:linear-gradient(90deg,#0b4ed8,#b3ccff 55%,#1c61ed);box-shadow:0 0 9px #2069ff}
.feat-name{top:107px;left:18px;right:16px;line-height:1.05;min-height:75px;display:flex;align-items:center;font-family:Impact,'Arial Narrow',sans-serif;font-weight:900;font-size:66px;letter-spacing:.55px;background:linear-gradient(180deg,#fff 0%,#edf1f6 14%,#989fad 31%,#3f4855 48%,#fff 53%,#a9adb8 70%,#353843 87%,#eff4ff 100%);background-clip:text;-webkit-background-clip:text;color:transparent;-webkit-text-stroke:.9px #d4d5dc;filter:drop-shadow(0 2px 0 #052669) drop-shadow(0 4px 0 #030a19) drop-shadow(0 6px 5px #000)}
.feat-name.long{font-size:62px}.feat-name.tag{font-size:70px}
.feat-members{font-family:Impact,'Arial Narrow',sans-serif;font-size:20px;letter-spacing:.7px;color:#bac8e4;bottom:9px}
.bottom-note{margin:11px 23px 0;height:53px;padding:0 11px 0 14px;background:linear-gradient(90deg,#0b255a 0%,#224da4 8%,#0c1831 49%,#10295d 95%);border:1px solid #396acd;border-left:4px solid #9abbff;box-shadow:inset 0 1px 7px #175ded25}
.bottom-note small{font-family:Impact,'Arial Narrow',sans-serif;font-style:italic;font-size:22px;letter-spacing:.25px;white-space:nowrap;background:linear-gradient(#f8faff 0%,#bfc5cd 39%,#525665 60%,#fbfcff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:.35px #bcc3d0;filter:drop-shadow(1px 2px 1px #000)}
#since{font-family:Impact,'Arial Narrow',sans-serif;font-size:43px;font-weight:900;letter-spacing:.5px;white-space:nowrap;background:linear-gradient(180deg,#fff9d1 0%,#f0d287 22%,#b07a30 47%,#fff0ad 61%,#8e5725 83%,#f4cb76 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-stroke:.7px #d9bc7e;filter:drop-shadow(0 2px 0 #5e2814) drop-shadow(0 3px 2px #000)}
.tagline{margin-top:7px;font-size:10px;letter-spacing:2px}
.ticker-label{font-family:Impact,'Arial Narrow',sans-serif;font-size:38px;text-shadow:0 2px 1px #000c25}
.ticker-body{font-family:Impact,'Arial Narrow',sans-serif;font-size:19px;letter-spacing:.55px}
/* Inclusive contrast and safe-area protections for Fire TV browser */
@media(prefers-reduced-motion:reduce){.ticker-text{animation:none}}

/* Paint gradients into glyph interiors, rather than the original flex anonymous text items. */
.feat-label{display:block;font-family:'Roboto Condensed','Liberation Sans Narrow',sans-serif;font-weight:1000;font-stretch:condensed;-webkit-text-fill-color:transparent;}
.feat-name{display:block;font-family:'Roboto Condensed','DejaVu Sans Condensed',sans-serif;font-weight:1000;font-stretch:condensed;font-size:62px;letter-spacing:-1.6px;top:111px;-webkit-text-fill-color:transparent;white-space:nowrap}
.feat-name.long{font-size:57px}.feat-name.tag{font-size:66px}
.crown-rule span{font-family:'Roboto Condensed','Liberation Sans Narrow',sans-serif;font-weight:1000;letter-spacing:-1px;-webkit-text-fill-color:transparent}
.bottom-note small{font-family:'Roboto Condensed',sans-serif;font-weight:1000;-webkit-text-fill-color:transparent}
.cap-left{font-family:'Roboto Condensed',sans-serif;font-weight:1000;-webkit-text-fill-color:transparent;letter-spacing:-.2px}
#since{font-family:'Roboto Condensed',sans-serif;font-weight:1000;-webkit-text-fill-color:transparent}

/* Broadcast-safe filled-metal fallback: highly legible on Silk at 720x1280. */
.crown-rule span{background:none!important;color:#eff3f9;-webkit-text-fill-color:#f0f3fb!important;-webkit-text-stroke:1.1px #606779;filter:none;text-shadow:0 1px 0 #fbfcff,0 3px 0 #838791,0 5px 0 #44444d,0 8px 7px #000,0 0 9px #145bed;font-size:53px}
.cap-left{background:none!important;color:#dfe3ed;-webkit-text-fill-color:#e0e5ed!important;-webkit-text-stroke:.3px #898c9a;filter:none;text-shadow:0 1px 0 #fff,0 3px 0 #6d6f7b,1px 5px 3px #000,0 0 7px #3571eb}
.feat-label{background:none!important;color:#efd9a5;-webkit-text-fill-color:#f4d89b!important;-webkit-text-stroke:.7px #9f7d46;filter:none;text-shadow:0 1px 0 #fff3ce,0 2px 0 #92703b,1px 4px 3px #000}
.feat-name{background:none!important;color:#ebedf3;-webkit-text-fill-color:#f5f6fa!important;-webkit-text-stroke:1px #6e7180;filter:none;text-shadow:0 1px 0 #fff,0 3px 0 #989fa9,0 5px 0 #444754,0 7px 0 #0e3481,1px 9px 5px #000}

/* TYPE PASS 2: always legible embossed metals, not transparent outline type */
.crown-rule{top:355px;height:65px;z-index:10;}
.crown-rule span{
 display:inline-block;line-height:1.06;padding:2px 8px 6px;
 background:none!important;color:#f6f8fd!important;-webkit-text-fill-color:#f6f8fd!important;
