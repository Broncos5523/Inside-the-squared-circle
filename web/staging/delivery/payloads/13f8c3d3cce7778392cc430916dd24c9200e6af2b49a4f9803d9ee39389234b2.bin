<!DOCTYPE html>
<html><head><meta charset="utf-8"/><meta content="width=device-width,initial-scale=1" name="viewport"/><title>King of the Ring — Preview V3 Review</title><style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#020202;overflow:hidden;font-family:Arial,sans-serif;color:white}body{display:grid;place-items:center}#board{position:relative;width:720px;height:1280px;overflow:hidden;background:#080604;transform-origin:center}.arena{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,#0009 0%,#0008 24%,#080503ed 36%,#080503f7 84%,#000d 100%)}.brand{position:absolute;top:8px;left:70px;width:580px;height:155px;object-fit:contain;filter:drop-shadow(0 4px 8px #000)}.subbrand{display:none}.event{position:absolute;bottom:5px;left:8px;width:190px;height:70px;z-index:5;object-fit:contain;filter:drop-shadow(0 5px 10px black)}.divider{position:absolute;top:320px;left:38px;right:38px;border-top:2px solid #d5a748;border-bottom:2px solid #d5a748;text-align:center;padding:11px 0;background:linear-gradient(90deg,#000b,#30210c,#000b);font:900 29px Impact,'Arial Narrow',sans-serif;letter-spacing:2px}.demo{position:absolute;top:389px;left:160px;right:160px;background:#d4a74b;color:#160e05;text-align:center;padding:5px;font-weight:900;letter-spacing:1px;font-size:12px}.panel{position:absolute;left:24px;right:24px;top:436px;height:495px;border:2px solid #c59b45;background:linear-gradient(115deg,#1d1409ee,#08090beb 50%,#211706ef);box-shadow:0 0 30px #a77d2a55}.panelhead{text-align:center;font:900 25px Impact,'Arial Narrow',sans-serif;letter-spacing:2px;color:#f6df9f;padding:18px 0 3px}.panelsub{text-align:center;color:#b9ad90;font-size:12px;font-weight:bold;letter-spacing:2px}.versus{display:grid;grid-template-columns:1fr 70px 1fr;gap:7px;margin:17px 13px 0;height:360px}.person{position:relative;border:1px solid #aa833e;background:radial-gradient(ellipse at center,#4b361a,#090806 80%);overflow:hidden}.person img{position:absolute;left:0;bottom:52px;width:100%;height:288px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 3px 5px black)}.name{position:absolute;bottom:0;left:0;right:0;min-height:56px;background:linear-gradient(transparent,#060504 18%);display:flex;align-items:end;justify-content:center;padding:6px 2px 12px;text-align:center;font:900 22px Impact,'Arial Narrow',sans-serif;letter-spacing:1px}.vs{display:grid;place-items:center;font:900 32px Impact,sans-serif;color:#f6d888;text-shadow:0 0 12px #aa7a26}.support{position:absolute;top:948px;left:24px;right:24px;height:218px;border:2px solid #ad8946;background:linear-gradient(120deg,#1d1309ee,#080909ed,#1d1509ed)}.supporthead{font:900 22px Impact,sans-serif;letter-spacing:2px;text-align:center;color:#f6d888;padding-top:10px}.supportgrid{display:grid;grid-template-columns:1fr 62px 1fr;gap:8px;height:158px;padding:8px 14px}.supportperson{position:relative;overflow:hidden;border:1px solid #6c562c;background:#15100a}.supportperson img{position:absolute;width:100%;height:120px;object-fit:contain;object-position:center bottom;bottom:30px}.supportperson b{position:absolute;bottom:0;left:0;right:0;text-align:center;background:#090705e8;padding:6px 0;font-size:14px}.supportvs{display:grid;place-items:center;font:900 24px Impact;color:#e4b953}.ticker{position:absolute;bottom:0;height:81px;left:0;right:0;background:#050505;border-top:3px solid #d8ae54;display:flex;align-items:center}.tickerlogo{width:205px;border-right:1px solid #b48b3c;padding:12px;font-size:18px;line-height:1.15;font-weight:900;color:#f4d99d}.tickertext{flex:1;text-align:center;font-size:15px;line-height:1.5;font-weight:bold;letter-spacing:1px}.crown{color:#d9b35d}

.shade{background:linear-gradient(180deg,#0007 0%,#0005 18%,#050302ad 33%,#050302f2 65%,#080501ed 100%)}
.brand{top:2px;height:132px;width:530px;left:95px;z-index:3}
.eyebrow{position:absolute;top:266px;left:30px;right:30px;text-align:center;font:900 30px Impact,'Arial Narrow',sans-serif;letter-spacing:4px;color:#fff0bc;text-shadow:0 3px 8px #000,0 0 18px #c28c37}
.demo{top:314px;left:170px;right:170px;background:#1c1208dd;border:1px solid #b99146;color:#f9e2ac;z-index:5;font-size:10px;padding:5px}
.royal{position:absolute;top:350px;left:18px;right:18px;height:490px;overflow:hidden;background:linear-gradient(130deg,#1a1007ed,#050505cc 55%,#281607e9);border:2px solid #e1b45e;box-shadow:0 0 30px #d99b3c77,inset 0 0 40px #000}
.royal:before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 53%,#a8732e4a,transparent 62%),linear-gradient(90deg,#ad771a18,transparent,#ad771a18)}
.royal-title{position:absolute;top:13px;left:0;right:0;text-align:center;font:900 34px Impact,sans-serif;letter-spacing:2px;color:#ffe3a2;text-shadow:0 3px 10px black}
.royal-sub{position:absolute;top:55px;left:0;right:0;text-align:center;font:800 12px Arial,sans-serif;letter-spacing:3px;color:#e4c27b}.royal-sub span{padding:0 8px}
.crownmark{position:absolute;top:80px;left:0;right:0;text-align:center;font-size:106px;color:#d7a341;opacity:.45;text-shadow:0 0 30px #ffc75a}
.face{position:absolute;top:103px;width:48%;height:323px;overflow:hidden}.face1{left:0}.face2{right:0}.face img{position:absolute;inset:0;width:100%;height:285px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 0 14px #9e6c2c)}.face strong{position:absolute;bottom:0;left:0;right:0;text-align:center;font:900 28px/0.93 Impact,sans-serif;letter-spacing:1px;text-shadow:0 3px 8px black,0 0 9px black;color:white}
.center-vs{position:absolute;top:264px;left:43%;width:14%;text-align:center;font:900 33px Impact,sans-serif;color:#ffe2a0;text-shadow:0 0 12px #000,0 0 14px #cc9a3a;z-index:2}
.goldline{position:absolute;bottom:58px;left:24px;right:24px;height:2px;background:linear-gradient(90deg,transparent,#f6c963,transparent)}
.herofoot{position:absolute;bottom:11px;left:0;right:0;text-align:center;font:900 27px Impact,sans-serif;letter-spacing:2px;color:#ffe4a5}.herofoot small{display:block;font:700 10px Arial;letter-spacing:3px;color:#d4b574;margin-top:3px}
.queen{position:absolute;top:856px;left:18px;right:18px;height:222px;display:flex;align-items:flex-end;gap:6px;padding:47px 13px 10px;border:2px solid #b58a42;background:linear-gradient(120deg,#261607e9,#090807ed,#271506e9);box-shadow:0 0 20px #a87c2750;overflow:hidden}
.queen-heading{position:absolute;top:8px;left:0;right:0;text-align:center;color:#f9d891;font:900 26px Impact,sans-serif;letter-spacing:2px}.queen-heading small{display:block;font:700 10px Arial;letter-spacing:2px;color:#d3b981;margin-top:2px}
.qface{position:relative;flex:1;height:158px;background:radial-gradient(ellipse at bottom,#5d3e17,#090705 70%);overflow:hidden;border-bottom:2px solid #d5a54b}.qface img{width:100%;height:142px;object-fit:contain;object-position:center bottom}.qface strong{position:absolute;bottom:0;left:0;right:0;background:#050403d9;text-align:center;font:900 16px Impact,sans-serif;padding:4px;color:#fff0d4}.qvs{align-self:center;font:900 25px Impact;color:#ffe2a0}
.road{position:absolute;top:1090px;left:18px;right:18px;height:87px;border:1px solid #ab823b;background:#100c08ed;display:flex;align-items:center;justify-content:center;gap:8px;padding:30px 8px 5px;color:#d2bb8b;font:700 11px Arial;letter-spacing:.5px}.road b{position:absolute;top:8px;left:0;right:0;text-align:center;color:#ffe1a1;font:900 19px Impact;letter-spacing:2px}.road i{height:2px;width:15px;background:#a87b33}.road .final{color:#ffe1a1}
.ticker{height:86px}.event{bottom:5px;left:5px;width:183px;height:74px}.tickertext{padding-left:205px;font-size:13px}

/* V3: user-supplied crowns; dedicated carousel for other PLE matches */
.real-crown{position:absolute;object-fit:contain;filter:drop-shadow(0 0 17px #dba648a8);z-index:3;pointer-events:none}
.king-crown{top:86px;left:247px;width:185px;height:146px;opacity:.96}
.queen-crown{width:98px;height:96px;top:57px;left:calc(50% - 49px);opacity:.96}
.queen .qvs{z-index:4;position:relative;align-self:flex-end;margin-bottom:43px;text-shadow:0 3px 7px #000}
.other-matches{position:absolute;top:1084px;left:18px;right:18px;height:102px;border:1px solid #c39a4b;background:linear-gradient(100deg,#171008ed,#060504ed,#171008ed);overflow:hidden;text-align:center}
.other-heading{font:900 18px Impact,sans-serif;letter-spacing:2px;color:#ffe4a5;margin:5px 0 2px}
.other-heading span{font-size:10px;color:#d8a947;vertical-align:middle}
.match-window{height:65px;overflow:hidden;position:relative}
.match-track{height:100%;display:flex;transition:transform .65s ease}
.match-slide{min-width:100%;height:100%;display:flex;align-items:center;justify-content:center;gap:7px;padding:1px 12px}.match-face{width:62px;height:62px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 0 5px #d5a24a)}.match-info{flex:1;min-width:0;text-align:center}.match-vs{font:900 15px Impact;color:#f8d582}
.match-slide b{font:900 15px Impact,sans-serif;color:white;letter-spacing:1px}
.match-slide small{font:700 10px Arial,sans-serif;color:#e7c57e;letter-spacing:.4px}
.match-dots{position:absolute;right:9px;top:6px;font-size:9px;letter-spacing:6px;color:#d8b56c;line-height:11px}
</style></head><body><div id="board"><img class="arena" src="__ISC_BASE__originals/shared/cd0883b397a29bae6ece5a74e8fb1f7a36d9a2005c5d571b7c951acd6c372a05.jpg"/><div class="shade"></div><img alt="Man Cave Sports Book Presents Inside the Squared Circle" class="brand" src="__ISC_BASE__originals/shared/6b8d91042edf7d48598c32f1b46d6451dfc9cc0c2d49eeb0e1a0be7b38d8fc13.png"/><img class="event" src="__ISC_BASE__originals/shared/0ee6c43c7314f765ee7715db03881b65b994006fd61f2a8db2bcd6359443cb08.png"/><div class="eyebrow">THE ROAD TO THE THRONE</div><div class="demo">DESIGN DEMO · PARTICIPANTS NOT CONFIRMED</div>
<section class="royal"><div class="royal-title">TWO CROWNS. ONE DESTINY.</div><div class="royal-sub">KING OF THE RING <span>✦</span> QUEEN OF THE RING</div><img alt="Men’s King of the Ring crown" class="real-crown king-crown" src="__ISC_BASE__originals/shared/ef37c66af1d70ed0251929a6e4ee70e92a5364cd671b0b01db5a949c098e642b.png"/><div class="face face1"><img src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"/><strong>ROMAN<br/>REIGNS</strong></div><div class="face face2"><img src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"/><strong>BRON<br/>BREAKKER</strong></div><div class="center-vs">VS</div><div class="goldline"></div><div class="herofoot">KING OF THE RING <small>TOURNAMENT SPOTLIGHT</small></div></section>
<section class="queen"><div class="queen-heading"><span>QUEEN OF THE RING</span><small>TOURNAMENT SPOTLIGHT</small></div><div class="qface"><img src="__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png"/><strong>LIV MORGAN</strong></div><div class="qvs">VS</div><img alt="Women’s Queen of the Ring crown" class="real-crown queen-crown" src="__ISC_BASE__originals/shared/52eecf0be62839a7d0487bd235445df9dceeba2ac11f498575295701cbc50f2f.png"/><div class="qface"><img src="__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png"/><strong>CHELSEA GREEN</strong></div></section>
<section class="other-matches"><div class="other-heading">ALSO ON THE CARD <span>◆</span> MORE MATCHES</div><div class="match-window"><div aria-live="off" class="match-track" id="other-match-track"><div class="match-slide"><img alt="Roman Reigns" class="match-face" src="__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png"/><div class="match-info"><b>SAMPLE MATCH • NOT CONFIRMED</b><div class="match-vs">ROMAN REIGNS VS BRON BREAKKER</div><small>Design demonstration only</small></div><img alt="Bron Breakker" class="match-face" src="__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png"/></div></div></div><div class="match-dots" id="match-dots">● ○ ○</div></section><footer class="ticker"><div aria-hidden="true" class="tickerlogo"></div><div class="tickertext">KING OF THE RING <span class="crown">✦</span> TOURNAMENT COVERAGE<br/>VERIFIED MATCHES WILL UPDATE WHEN AVAILABLE</div></footer></div><script>function fit(){document.getElementById('board').style.transform='scale('+Math.min(innerWidth/720,innerHeight/1280)+')'}addEventListener('resize',fit);fit();
// Production data contract: window.KOTR_ADDITIONAL_MATCHES = [{title, detail}, ...]
// Do not invent matches. Preview placeholders are explicitly marked as awaiting confirmation.
const demoCards=[
 {title:'SAMPLE MATCH • NOT CONFIRMED',detail:'Layout demonstration only',left:'Roman Reigns',right:'Bron Breakker',leftImage:'__ISC_BASE__originals/shared/ffcfac04fd44df06eb5025115a7913307e19a3cf3996c46596a8f15195a0ea22.png',rightImage:'__ISC_BASE__originals/shared/293a7c098bcbd0ebed698a9d3039b546a0c4e6eae0fd55f16caa4209d08ecb85.png'},
 {title:'SAMPLE MATCH • NOT CONFIRMED',detail:'Layout demonstration only',left:'Liv Morgan',right:'Chelsea Green',leftImage:'__ISC_BASE__originals/shared/92bddf1c43a8a10bcc82d5188585a5fbb6fe7a84d7c5b700676541763af53909.png',rightImage:'__ISC_BASE__originals/shared/636315a7bc721e78ad8ad1128ffd06c4388bb21b9a206bddda9fb2d6de1995d5.png'}
];
// Production contract: window.KOTR_ADDITIONAL_MATCHES = [{title,detail,left,right,leftImage,rightImage}, ...]
// Supply only officially verified matches. Demo data is isolated to review mode.
const production=Array.isArray(window.KOTR_ADDITIONAL_MATCHES)?window.KOTR_ADDITIONAL_MATCHES.filter(m=>m&&m.title):[];
const isDemo=!production.length;
const additionalMatches=isDemo?demoCards:production;
const track=document.getElementById('other-match-track'),dots=document.getElementById('match-dots');
function safe(s){return String(s||'').replace(/[&<>'"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function img(src,alt){return src?'<img class="match-face" src="'+safe(src)+'" alt="'+safe(alt)+'">':'<div class="match-face"></div>'}
track.innerHTML=additionalMatches.map(m=>'<div class="match-slide">'+img(m.leftImage,m.left)+'<div class="match-info"><b>'+safe(m.title)+'</b><div class="match-vs">'+safe(m.left||'')+(m.left&&m.right?'  VS  ':'')+safe(m.right||'')+'</div><small>'+safe(m.detail)+'</small></div>'+img(m.rightImage,m.right)+'</div>').join('');
let matchIndex=0;
function showMatch(i){matchIndex=i%additionalMatches.length;track.style.transform='translateX(-'+matchIndex*100+'%)';dots.textContent=additionalMatches.map((_,j)=>j===matchIndex?'●':'○').join(' ')}
showMatch(0);if(additionalMatches.length>1)setInterval(()=>showMatch(matchIndex+1),6500);
</script></body></html>
